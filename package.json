{
  "name": "adeonir-dev",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "email": "email dev --dir src/emails",
    "typecheck": "astro check",
    "test": "vitest run",
    "lint": "biome check && prettier --check \"src/**/*.{astro,yaml}\"",
    "lint:fix": "biome check --write --unsafe && prettier --write \"src/**/*.{astro,yaml}\"",
    "lighthouse": "astro build && npx -y @lhci/cli autorun",
    "gates": "pnpm typecheck && pnpm lint:fix"
  },
  "dependencies": {
    "@ark-ui/react": "5.38.2",
    "@astrojs/cloudflare": "13.7.0",
    "@astrojs/react": "5.0.7",
