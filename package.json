{
  "name": "adeonir-dev",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "email": "email dev --dir src/emails",
    "typecheck": "astro check",
    "test": "vitest run",
    "lint": "biome check --error-on-warnings && prettier --check \"src/**/*.{astro,yaml}\"",
    "lint:fix": "biome check --write --unsafe --error-on-warnings && prettier --write \"src/**/*.{astro,yaml}\"",
    "lighthouse": "astro build && npx -y @lhci/cli autorun",
    "narration": "tsx --env-file=.env src/services/narration.ts"
  },
  "dependencies": {
    "@ark-ui/react": "5.39.2",
    "@astrojs/cloudflare": "14.3.3",
    "@astrojs/mdx": "8.0.2",
    "@astrojs/react": "7.0.0",
    "@astrojs/sitemap": "3.7.4",
    "@nanostores/react": "2.0.1",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "astro-robots-txt": "1.0.0",
    "astro-seo": "1.2.0",
    "class-variance-authority": "0.7.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "motion": "13.4.4",
    "nanostores": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/ts-plugin": "1.10.12",
    "@biomejs/biome": "2.5.14",
    "@iconify-json/tabler": "1.2.41",
    "@react-email/ui": "6.11.0",
    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "@tailwindcss/typography": "0.5.20",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "20.14.5",
    "lefthook": "2.1.14",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react-email": "6.11.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "unplugin-icons": "24.0.0",
    "vitest": "5.0.2",
    "wrangler": "4.143.0",
    "yaml": "2.9.1"
  }
