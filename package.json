{
  "name": "adeonir-dev",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "email": "email dev --dir src/emails",
    "typecheck": "astro check",
    "lint": "biome check && prettier --check \"src/**/*.{astro,yaml}\"",
    "lint:fix": "biome check --write --unsafe && prettier --write \"src/**/*.{astro,yaml}\"",
    "lighthouse": "astro build && npx -y @lhci/cli autorun",
    "gates": "pnpm typecheck && pnpm lint:fix"
  },
  "dependencies": {
    "@ark-ui/react": "5.37.2",
    "@astrojs/cloudflare": "13.7.0",
    "@astrojs/react": "5.0.7",
    "@astrojs/sitemap": "3.7.3",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.0.8",
    "@tailwindcss/vite": "4.3.1",
    "astro": "6.4.6",
    "astro-robots-txt": "1.0.0",
    "astro-seo": "1.1.0",
    "class-variance-authority": "0.7.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss": "4.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@biomejs/biome": "2.5.0",
    "@iconify-json/tabler": "1.2.35",
