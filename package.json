{
  "name": "adeonir-dev",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "email": "email dev --dir src/emails",
    "typecheck": "astro check",
    "test": "vitest run",
    "lint": "biome check --error-on-warnings && prettier --check \"src/**/*.{astro,yaml}\"",
    "lint:fix": "biome check --write --unsafe --error-on-warnings && prettier --write \"src/**/*.{astro,yaml}\"",
    "lighthouse": "astro build && npx -y @lhci/cli autorun"
  },
