    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "lefthook": "2.1.9",
    "prettier": "3.8.4",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.0",
    "react-email": "6.6.0",
    "typescript": "6.0.3",
    "unplugin-icons": "23.0.1",
    "wrangler": "4.100.0"
  }
