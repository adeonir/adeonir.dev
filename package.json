{
  "name": "adeonir-dev",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "test": "vitest run",
    "lint": "biome check --error-on-warnings && prettier --check \"src/**/*.astro\"",
    "lint:fix": "biome check --write --unsafe --error-on-warnings && prettier --write \"src/**/*.astro\"",
    "lighthouse": "astro build && npx -y @lhci/cli autorun",
    "email": "email dev --dir src/components/emails",
    "audio": "tsx --env-file=.env scripts/audio.ts",
    "peaks": "tsx scripts/peaks.ts"
  },
  "dependencies": {
    "@ark-ui/react": "5.40.0",
    "@astrojs/cloudflare": "14.4.7",
    "@astrojs/mdx": "8.1.5",
    "@astrojs/react": "7.1.8",
    "@astrojs/sitemap": "3.7.4",
    "@nanostores/react": "2.0.1",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.11",
    "astro-robots-txt": "1.0.0",
    "astro-seo": "1.2.0",
    "class-variance-authority": "0.7.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "motion": "14.12.0",
    "nanostores": "1.5.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "6.11.11",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/ts-plugin": "1.11.0",
    "@biomejs/biome": "2.6.6",
    "@iconify-json/tabler": "1.2.44",
    "@react-email/ui": "6.11.11",
    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "@tailwindcss/typography": "0.5.20",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "21.0.4",
    "lefthook": "2.2.2",
    "mpg123-decoder": "1.0.3",
    "prettier": "3.10.0",
    "prettier-plugin-astro": "1.1.2",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "unplugin-icons": "24.0.0",
    "vitest": "5.1.0",
    "wrangler": "4.160.1",
    "yaml": "2.9.1"
  }
