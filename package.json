    "@nanostores/react": "1.1.0",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "6.4.8",
    "astro-robots-txt": "1.0.0",
    "astro-seo": "1.1.0",
    "class-variance-authority": "0.7.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "nanostores": "1.5.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
