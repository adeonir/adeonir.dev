    "@nanostores/react": "2.0.1",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.1",
    "astro-robots-txt": "1.0.0",
    "astro-seo": "1.2.0",
    "class-variance-authority": "0.7.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "motion": "13.2.0",
