---
import audio from '~/data/audio.json'
import peaksByPath from '~/data/peaks.json'
import { NarrationControl } from '~/components/islands/home/narration-control'
import { parseLocale } from '~/helpers/locale'
import {
  NARRATION_BARS,
  type NarrationSection,
  placeholderPeaks,
} from '~/helpers/narration'
import { getLocalizedEntry } from '~/services/localized'

interface Props {
  section: NarrationSection
  class?: string
}

const { section, class: className } = Astro.props

const locale = parseLocale(Astro.currentLocale)
const narration = await getLocalizedEntry('homeNarration', locale)
const { labels, error } = narration.data
const src = audio[locale][section]
const peaks =
  (peaksByPath as Record<string, number[]>)[src] ??
  placeholderPeaks(src, NARRATION_BARS)
---

<div class={className}>
  <NarrationControl
    client:visible
    section={section}
    locale={locale}
    src={src}
    label={labels[section]}
    peaks={peaks}
    error={error}
  />
</div>
