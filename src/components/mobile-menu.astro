---
import { MobileMenu } from '~/components/islands/mobile-menu'
import { parseLocale } from '~/helpers/content'
import { getLocalizedEntry } from '~/services/localized'

interface Props {
  nav: { label: string; href: string }[]
}

const locale = parseLocale(Astro.currentLocale)
const content = await getLocalizedEntry('mobileMenu', locale)

const { nav } = Astro.props
---

<MobileMenu client:visible nav={nav} content={content.data}>
  <slot />
</MobileMenu>
