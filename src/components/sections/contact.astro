---
import { actions } from 'astro:actions'
import { getEntry } from 'astro:content'

import { buttonVariants } from '~/components/ui/button'
import { Eyebrow } from '~/components/ui/eyebrow'
import { Field } from '~/components/ui/field'
import { cn } from '~/helpers/classnames'
import IconFolder from '~icons/tabler/folder'

interface Props {
  state?: 'success' | 'error'
}

const { state } = Astro.props

const contact = await getEntry('contact', 'contact')

if (!contact) {
  throw new Error('Missing contact/contact entry')
}

const { eyebrow, title, body, social, form } = contact.data
---

<section id="contact">
  <Eyebrow>{eyebrow}</Eyebrow>
  <div class="mt-6 grid grid-cols-1 gap-12 md:grid-cols-2">
    <div class="flex flex-col gap-6">
      <h2 class="text-display text-pretty text-foreground">
        {
          title.map((segment) => (
            <>
              {segment.strong ? (
                <span class="text-secondary">{segment.text}</span>
              ) : (
                segment.text
              )}
              {segment.break && <br class="hidden md:block" />}
            </>
          ))
        }
      </h2>
      <div class="flex flex-col gap-4">
        {
          body.map((paragraph) => (
            <p class="text-body leading-relaxed text-pretty text-muted-foreground">
              {paragraph}
            </p>
          ))
        }
      </div>
      <div class="mt-2 flex flex-col gap-2">
        <p class="inline-flex items-center gap-2 text-code text-foreground">
          <IconFolder className="size-4 shrink-0 text-action" />
          <span>contact/</span>
        </p>
        <ul
          aria-label="Canais de contato"
          class="relative flex flex-col gap-1 pl-5 before:absolute before:top-0 before:bottom-2.5 before:left-1.5 before:w-2 before:rounded-bl-lg before:border-b before:border-l before:border-border"
        >
          {
            social.map((channel) => {
              const external = channel.platform !== 'email'
              return (
                <li class="flex gap-2 text-code">
                  <span class="text-secondary" aria-hidden="true">
                    -
                  </span>
                  <a
                    href={channel.link}
                    class="-mx-1 rounded-sm px-1 text-muted-foreground transition hover:text-action focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background focus-visible:outline-none"
                    {...(external
                      ? { target: '_blank', rel: 'noopener noreferrer' }
                      : {})}
                  >
                    {channel.label}
                  </a>
                </li>
              )
            })
          }
        </ul>
      </div>
    </div>
    {
      state === 'success' ? (
        <div
          role="status"
          class="flex flex-col gap-2 rounded-lg border border-border bg-card p-6"
        >
          <p class="text-body text-pretty text-foreground">
            {form.states.success}
          </p>
        </div>
      ) : state === 'error' ? (
        <div
          role="alert"
          class="flex flex-col gap-2 rounded-lg border border-border bg-card p-6"
        >
          <p class="text-body text-pretty text-foreground">
            {form.states.error}
          </p>
        </div>
      ) : (
        <form
          method="POST"
          action={'/contact' + actions.contact}
          class="flex flex-col gap-6"
        >
          <input
            type="text"
            name="website"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
            class="sr-only"
          />
          {form.fields.map((field) => (
            <Field
              label={field.label}
              name={field.name}
              placeholder={field.placeholder}
              type={field.name === 'email' ? 'email' : 'text'}
              multiline={field.name === 'message'}
            />
          ))}
          <button
            type="submit"
            class={cn(buttonVariants({ variant: 'primary' }), 'w-fit')}
          >
            {form.submit}
          </button>
        </form>
      )
    }
  </div>
</section>
