---
import { getEntry } from 'astro:content'

import MobileMenu from '~/components/islands/mobile-menu'
import NavLink from '~/components/ui/nav-link'

const header = await getEntry('header', 'header')

if (!header) {
  throw new Error('Missing header/header entry')
}

const { logo, nav, menu } = header.data
---

<header
  transition:persist="header"
  class="sticky top-0 z-50 border-b border-border bg-background/90 backdrop-blur"
>
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-6">
    <a
      href="/"
      class="-mx-1.5 -my-0.5 shrink-0 rounded-sm px-1.5 py-0.5 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background focus-visible:outline-none"
    >
      <img class="w-32" src="/logo.svg" alt={logo} />
    </a>
    <nav class="hidden md:block">
      <ul class="flex items-center gap-6">
        {
          nav.map((item) => (
            <li>
              <NavLink href={item.href}>{item.label}</NavLink>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="md:hidden">
      <MobileMenu
        client:media="(max-width: 47.9375rem)"
        nav={nav}
        menu={menu}
      />
    </div>
  </div>
</header>
