---
import { getRelativeLocaleUrl } from 'astro:i18n'

import Logo from '~/components/logo.astro'
import LanguageToggle from '~/components/language-toggle.astro'
import MobileMenu from '~/components/mobile-menu.astro'
import ThemeToggle from '~/components/theme-toggle.astro'
import { Divider } from '~/components/ui/divider'
import { NavLink } from '~/components/ui/nav-link'
import { parseLocale } from '~/helpers/locale'
import { getLocalizedEntry } from '~/services/localized'

const locale = parseLocale(Astro.currentLocale)
const header = await getLocalizedEntry('sharedHeader', locale)
const homeURL = getRelativeLocaleUrl(locale)

const isNotFound = Astro.response.status === 404

const { logo } = header.data
const menu = await getLocalizedEntry('sharedMobileMenu', locale)

const nav = header.data.nav.map((item) => ({
  ...item,
  href: item.href.startsWith('#') ? `${homeURL}${item.href}` : item.href,
}))
---

<header
  transition:persist={`header-${locale}-${isNotFound ? 'not-found' : 'page'}`}
  class="pointer-events-none sticky top-0 z-50 pt-6 pb-4 transition-transform duration-600 ease-out motion-safe:data-[state=hidden]:-translate-y-3/2 md:pt-8 md:pb-2"
>
  <div class="wrapper">
    <div
      aria-hidden="true"
      class="mx-auto h-14 max-w-3xl rounded-full border border-border bg-sunken/70 shadow-lg shadow-black/50 backdrop-blur-sm backdrop-saturate-200 light:bg-sunken/80 light:shadow-black/25 reduce-transparency:bg-sunken reduce-transparency:backdrop-blur-none"
    ></div>
  </div>
  <div
    data-menu-surface
    class="pointer-events-auto absolute inset-x-0 top-0 h-dvh [clip-path:inset(1.5rem_1.5rem_calc(100%_-_5rem)_1.5rem_round_1.75rem)] in-data-[menu=open]:bg-popover in-data-[menu=open]:[clip-path:inset(0_round_0)] md:pointer-events-none md:[clip-path:none]"
  >
    <div class="wrapper pt-6 md:pt-8">
      <div class="pointer-events-auto mx-auto flex h-14 max-w-3xl items-center justify-between px-5">
        <a
          href={homeURL}
          class="-mx-1.5 -my-0.5 shrink-0 rounded-sm px-1.5 py-0.5 transition focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background focus-visible:outline-none"
        >
          <Logo class="w-32" label={logo} />
        </a>
        <div class="flex items-center gap-4">
          {!isNotFound && (
            <>
              <nav class="hidden md:block">
                <ul class="flex items-center gap-6">
                  {nav.map((item) => (
                    <li>
                      <NavLink href={item.href}>{item.label}</NavLink>
                    </li>
                  ))}
                </ul>
              </nav>
              <Divider
                orientation="vertical"
                className="mx-1 hidden h-5 md:block"
              />
            </>
          )}
          {isNotFound ? (
            <div class="flex items-center gap-4">
              <ThemeToggle />
              <LanguageToggle locale={locale} />
            </div>
          ) : (
            <>
              <div class="hidden items-center gap-4 xxs:flex">
                <ThemeToggle />
                <LanguageToggle locale={locale} />
              </div>
              <div class="md:hidden">
                <MobileMenu />
              </div>
            </>
          )}
        </div>
      </div>
      {!isNotFound && (
        <nav
          aria-label={menu.data.label}
          class="wrapper invisible absolute inset-x-0 bottom-0 in-data-[menu=open]:visible md:hidden [&:has(a:active)_a:not(:active)]:opacity-30 [&:has(a:active)_a:not(:active)]:blur-[2px] [&_a:active]:font-semibold [&_a]:font-normal [&_a]:[-webkit-tap-highlight-color:transparent]"
        >
          <div class="mx-auto max-w-3xl px-5">
            <ul class="mb-24 flex flex-col gap-3">
              {nav.map((item) => (
                <li>
                  <NavLink
                    href={item.href}
                    data-menu-link
                    className="font-sans text-4xl font-normal text-foreground"
                  >
                    {item.label}
                  </NavLink>
                </li>
              ))}
            </ul>
          </div>
          <div class="wrapper absolute inset-x-0 bottom-8 xxs:hidden">
            <div class="mx-auto flex max-w-3xl items-center gap-4 px-5">
              <ThemeToggle />
              <LanguageToggle locale={locale} />
            </div>
          </div>
        </nav>
      )}
    </div>
  </div>
</header>
