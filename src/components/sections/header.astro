---
import { getRelativeLocaleUrl } from 'astro:i18n'

import Logo from '~/components/logo.astro'
import LanguageToggle from '~/components/language-toggle.astro'
import MobileMenu from '~/components/mobile-menu.astro'
import ThemeToggle from '~/components/theme-toggle.astro'
import { Divider } from '~/components/ui/divider'
import { NavLink } from '~/components/ui/nav-link'
import { parseLocale } from '~/helpers/content'
import { getLocalizedEntry } from '~/services/localized'

const locale = parseLocale(Astro.currentLocale)
const header = await getLocalizedEntry('sharedHeader', locale)
const homeURL = getRelativeLocaleUrl(locale)

const isNotFound = Astro.response.status === 404

const { logo } = header.data

const nav = header.data.nav.map((item) => ({
  ...item,
  href: item.href.startsWith('#') ? `${homeURL}${item.href}` : item.href,
}))
---

<header
  transition:persist={`header-${locale}-${isNotFound ? 'not-found' : 'page'}`}
  class="pointer-events-none sticky top-0 z-50 pt-6 pb-4 transition-transform duration-600 ease-out motion-safe:data-[state=hidden]:-translate-y-3/2 md:pt-8 md:pb-2"
>
  <div class="wrapper">
    <div
      class="pointer-events-auto mx-auto flex h-14 max-w-3xl items-center justify-between rounded-full border border-border bg-sunken/70 px-5 shadow-lg shadow-black/50 backdrop-blur-sm backdrop-saturate-200 light:bg-sunken/80 light:shadow-black/25 reduce-transparency:bg-sunken reduce-transparency:backdrop-blur-none"
    >
      <a
        href={homeURL}
        class="-mx-1.5 -my-0.5 shrink-0 rounded-sm px-1.5 py-0.5 transition focus-visible:ring-4 focus-visible:ring-ring/50 focus-visible:ring-offset-2 focus-visible:ring-offset-background focus-visible:outline-none"
      >
        <Logo class="w-32" label={logo} />
      </a>
      <div class="flex items-center gap-4">
        {
          !isNotFound && (
            <>
              <nav class="hidden md:block">
                <ul class="flex items-center gap-6">
                  {nav.map((item) => (
                    <li>
                      <NavLink href={item.href}>{item.label}</NavLink>
                    </li>
                  ))}
                </ul>
              </nav>
              <Divider
                orientation="vertical"
                className="mx-1 hidden h-5 md:block"
              />
            </>
          )
        }
        {
          isNotFound ? (
            <div class="flex items-center gap-4">
              <ThemeToggle />
              <LanguageToggle locale={locale} />
            </div>
          ) : (
            <>
              <div class="hidden items-center gap-4 xxs:flex">
                <ThemeToggle />
                <LanguageToggle locale={locale} />
              </div>
              <div class="md:hidden">
                <MobileMenu nav={nav}>
                  <Divider className="block xxs:hidden" />
                  <div class="flex items-center gap-4 xxs:hidden">
                    <ThemeToggle />
                    <LanguageToggle locale={locale} />
                  </div>
                </MobileMenu>
              </div>
            </>
          )
        }
      </div>
    </div>
  </div>
</header>
