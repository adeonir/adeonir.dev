---
import { getEntry } from 'astro:content'

import Logo from '~/components/logo.astro'
import MobileMenu from '~/components/mobile-menu.astro'
import ThemeToggle from '~/components/theme-toggle.astro'
import { Divider } from '~/components/ui/divider'
import { NavLink } from '~/components/ui/nav-link'

const header = await getEntry('header', 'header')

if (!header) {
  throw new Error('Missing header/header entry')
}

const { logo, nav } = header.data
---

<header
  transition:persist="header"
  class="sticky top-0 z-50 bg-sunken/10 backdrop-blur-md reduce-transparency:bg-sunken reduce-transparency:backdrop-blur-none"
>
  <div class="wrapper flex h-24 items-center justify-between">
    <a
      href="/"
      class="-mx-1.5 -my-0.5 shrink-0 rounded-sm px-1.5 py-0.5 transition focus-visible:ring-4 focus-visible:ring-ring/70 focus-visible:ring-offset-2 focus-visible:ring-offset-background focus-visible:outline-none"
    >
      <Logo class="w-32" label={logo} />
    </a>
    <div class="flex items-center gap-4">
      <nav class="hidden md:block">
        <ul class="flex items-center gap-6">
          {
            nav.map((item) => (
              <li>
                <NavLink href={item.href}>{item.label}</NavLink>
              </li>
            ))
          }
        </ul>
      </nav>
      <Divider orientation="vertical" className="hidden h-5 md:block" />
      <div class="hidden xxs:block">
        <ThemeToggle />
      </div>
      <div class="md:hidden">
        <MobileMenu nav={nav}>
          <Divider className="block xxs:hidden" />
          <div class="flex items-center gap-4 xxs:hidden">
            <ThemeToggle />
          </div>
        </MobileMenu>
      </div>
    </div>
  </div>
</header>
