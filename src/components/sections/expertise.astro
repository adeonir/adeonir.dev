---
import { Eyebrow } from '~/components/ui/eyebrow'
import { parseLocale } from '~/helpers/content'
import { getLocalizedEntry } from '~/services/localized'

const locale = parseLocale(Astro.currentLocale)
const expertise = await getLocalizedEntry('expertise', locale)

const { eyebrow, headline, body, items } = expertise.data
---

<section id="expertise" class="pt-16 pb-4 md:pt-20 md:pb-8">
  <div class="wrapper">
    <div class="mt-12 grid grid-cols-1 gap-12 md:grid-cols-5">
      <div class="flex flex-col gap-6 md:col-span-2">
        <Eyebrow data-enter="block" variant="muted">{eyebrow}</Eyebrow>
        <h2 data-enter="block" class="text-display text-pretty text-foreground">
          {
            headline.map((segment) => (
              <>
                {segment.highlight ? (
                  <span class="text-secondary">{segment.text}</span>
                ) : (
                  segment.text
                )}
              </>
            ))
          }
        </h2>
        <p
          data-enter="block"
          class="text-body leading-relaxed text-pretty text-muted-foreground"
        >
          {body}
        </p>
      </div>
      <div class="flex flex-col gap-6 md:col-span-3 md:pt-14">
        <ul class="flex flex-col gap-8">
          {
            items.map((item) => (
              <li data-enter="block" class="flex gap-4">
                <span
                  aria-hidden="true"
                  class="mt-2.5 size-1.5 shrink-0 bg-secondary"
                />
                <div class="flex flex-col gap-2">
                  <p class="text-code text-foreground">{item.title}</p>
                  <p class="text-body leading-relaxed text-pretty text-muted-foreground">
                    {item.description}
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
