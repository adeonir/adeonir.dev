---
import { getEntry } from 'astro:content'

import { Eyebrow } from '~/components/ui/eyebrow'
import { cn } from '~/helpers/classnames'

const about = await getEntry('about', 'about')

if (!about) {
  throw new Error('Missing about/about entry')
}

const { eyebrow, headline, bio } = about.data
---

<section
  id="about"
  class="-scroll-mt-16 pt-24 pb-16 md:-scroll-mt-24 md:pt-32 md:pb-24"
>
  <div class="wrapper">
    <div class="mt-6 grid grid-cols-1 gap-12 md:grid-cols-5">
      <h2
        data-enter="block"
        class="text-display text-pretty text-foreground md:col-span-2"
      >
        {
          headline.map((segment) => (
            <>
              {segment.highlight ? (
                <span class="text-secondary">{segment.text}</span>
              ) : (
                <span class="text-muted-foreground">{segment.text}</span>
              )}
            </>
          ))
        }
      </h2>
      <div class="flex flex-col gap-6 md:col-span-3">
        <Eyebrow data-enter="block" variant="muted">{eyebrow}</Eyebrow>
        {
          bio.map((paragraph, index) => (
            <p
              data-enter="block"
              class={cn(
                'leading-relaxed text-pretty',
                index === 0
                  ? 'text-subtitle text-foreground'
                  : 'text-body text-muted-foreground',
              )}
            >
              {paragraph}
            </p>
          ))
        }
      </div>
    </div>
  </div>
</section>
