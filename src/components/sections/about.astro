---
import { getEntry } from 'astro:content'

import { Eyebrow } from '~/components/ui/eyebrow'

const about = await getEntry('about', 'about')

if (!about) {
  throw new Error('Missing about/about entry')
}

const { eyebrow, headline, bio } = about.data
---

<section id="about">
  <Eyebrow variant="muted">{eyebrow}</Eyebrow>
  <h2 class="mt-6 text-display text-pretty text-foreground">
    {
      headline.map((segment) => (
        <>
          {segment.highlight ? (
            <span class="text-secondary">{segment.text}</span>
          ) : (
            segment.text
          )}
          {segment.break && <br class="hidden md:block" />}
        </>
      ))
    }
  </h2>
  <div class="mt-12 flex max-w-2xl flex-col gap-4">
    {
      bio.map((paragraph) => (
        <p class="text-body leading-relaxed text-pretty text-muted-foreground">
          {paragraph}
        </p>
      ))
    }
  </div>
</section>
