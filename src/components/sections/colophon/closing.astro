---
import { getRelativeLocaleUrl } from 'astro:i18n'

import { buttonVariants } from '~/components/ui/button-variants'
import { cn } from '~/helpers/classnames'
import { parseLocale } from '~/helpers/locale'
import { getLocalizedEntry } from '~/services/localized'

const locale = parseLocale(Astro.currentLocale)
const closing = await getLocalizedEntry('colophonClosing', locale)

const { headline, action } = closing.data
const contactHref = `${getRelativeLocaleUrl(locale)}#contact`
---

<section id="closing" class="pt-8 pb-16">
  <div class="wrapper">
    <div class="mx-auto flex w-full max-w-2xl flex-col items-start gap-6 border-t border-border pt-12 md:flex-row md:items-center md:justify-between">
      <p
        data-enter="block"
        class="max-w-lg text-2xl leading-snug font-semibold text-balance text-foreground"
      >
        {headline}
      </p>
      <a
        data-enter="block"
        href={contactHref}
        class={cn(
          buttonVariants({ variant: 'default', size: 'default' }),
          'shrink-0',
        )}
      >
        {action}
      </a>
    </div>
  </div>
</section>
