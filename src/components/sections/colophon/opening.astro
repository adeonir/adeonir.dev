---
import { getRelativeLocaleUrl } from 'astro:i18n'

import { buttonVariants } from '~/components/ui/button-variants'
import { Eyebrow } from '~/components/ui/eyebrow'
import { cn } from '~/helpers/classnames'
import { parseLocale } from '~/helpers/locale'
import { getLocalizedEntry } from '~/services/localized'
import IconArrowLeft from '~icons/tabler/arrow-left'
import IconArrowUpRight from '~icons/tabler/arrow-up-right'

const locale = parseLocale(Astro.currentLocale)
const opening = await getLocalizedEntry('colophonOpening', locale)

const { back, eyebrow, headline, links } = opening.data
const homeHref = getRelativeLocaleUrl(locale)

const linkClass = cn(
  'group size-fit gap-2 text-button',
  buttonVariants({ variant: 'link', size: 'inline' }),
)
---

<section class="pt-8 pb-4 md:pt-16 md:pb-8">
  <div class="wrapper">
    <div class="mx-auto flex w-full max-w-2xl flex-col gap-16">
      <a
        href={homeHref}
        class={cn(
          'group size-fit gap-2',
          buttonVariants({ variant: 'link', size: 'inline' }),
        )}
      >
        <IconArrowLeft className="size-4 shrink-0 transition-transform duration-200 motion-safe:group-hover:-translate-x-1" />
        {back}
      </a>
      <div class="flex flex-col items-start gap-6">
        <Eyebrow data-enter="block">{eyebrow}</Eyebrow>
        <h1 data-enter="block" class="text-display text-pretty text-foreground">
          {headline.map((segment) => (
            <>
              {segment.highlight ? (
                <span class="text-secondary">{segment.text}</span>
              ) : (
                segment.text
              )}
            </>
          ))}
        </h1>
        <div class="mt-2 flex flex-wrap gap-6">
          {links.map((link) => (
            <a
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
              class={linkClass}
            >
              {link.label}
              <IconArrowUpRight className="size-5 shrink-0 transition-transform duration-200 motion-safe:group-hover:-translate-y-0.5" />
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
