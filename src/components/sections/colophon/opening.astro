---
import { getRelativeLocaleUrl } from 'astro:i18n'

import Motivation from '~/components/sections/colophon/motivation.astro'
import { Divider } from '~/components/ui/divider'
import { Link } from '~/components/ui/link'
import { parseLocale } from '~/helpers/locale'
import { getLocalizedEntry } from '~/services/localized'

const locale = parseLocale(Astro.currentLocale)
const opening = await getLocalizedEntry('colophonOpening', locale)

const { back, eyebrow, headline, links } = opening.data
const homeHref = getRelativeLocaleUrl(locale)
---

<section id="opening" class="pt-8 md:pt-16">
  <div class="wrapper">
    <div class="mx-auto flex w-full max-w-2xl flex-col items-start gap-16">
      <Link data-enter="block" href={homeHref} icon="arrow-left" size="small">
        {back}
      </Link>
      <div class="flex w-full flex-col items-start gap-6">
        <p
          data-enter="block"
          class="text-label text-muted-foreground uppercase"
        >
          {eyebrow}
        </p>
        <h1
          data-enter="block"
          class="max-w-lg text-5xl leading-none font-extrabold tracking-tight text-balance text-foreground md:text-6xl"
        >
          {headline.map((segment) => (
            <>
              {segment.highlight ? (
                <span class="text-secondary">{segment.text}</span>
              ) : (
                segment.text
              )}
            </>
          ))}
        </h1>
        <Motivation />
        <div data-enter="block" class="flex flex-wrap gap-x-8 gap-y-2">
          {links.map((link) => (
            <Link
              href={link.href}
              icon={link.external ? undefined : 'arrow-up-right'}
              size="small"
            >
              {link.label}
            </Link>
          ))}
        </div>
      </div>
    </div>
  </div>
  <Divider className="mx-auto mt-8 mb-0 flex w-full max-w-2xl md:mt-16" />
</section>
