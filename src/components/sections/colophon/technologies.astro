---
import { parseLocale } from '~/helpers/locale'
import { Link } from '~/components/ui/link'
import { getLocalizedEntry } from '~/services/localized'

const locale = parseLocale(Astro.currentLocale)
const technologies = await getLocalizedEntry('colophonTechnologies', locale)

const { headline, groups } = technologies.data
---

<section id="technologies" class="pt-12 pb-8">
  <div class="wrapper">
    <div class="mx-auto flex w-full max-w-4xl flex-col gap-7">
      <h2 data-enter="block" class="mt-0 text-heading text-foreground">
        {headline}
      </h2>
      <div class="flex flex-col">
        {groups.map((group) => (
          <div
            data-enter="block"
            class="flex flex-col gap-2 border-t border-border py-7 first:border-t-0 first:pt-0 last:pb-0 md:flex-row md:gap-12"
          >
            <h3 class="text-label text-muted-foreground uppercase md:mt-1.5 md:w-28 md:shrink-0">
              {group.label}
            </h3>
            <div class="flex max-w-2xl flex-col gap-4 text-body leading-relaxed text-muted-foreground">
              {group.paragraphs.map((paragraph) => (
                <p class="text-pretty">
                  {paragraph.map((segment) =>
                    segment.href ? (
                      <Link href={segment.href} size="large">
                        {segment.text}
                      </Link>
                    ) : (
                      segment.text
                    ),
                  )}
                </p>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
