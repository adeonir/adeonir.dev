---
import { parseLocale } from '~/helpers/locale'
import { getLocalizedEntry } from '~/services/localized'

const locale = parseLocale(Astro.currentLocale)
const technologies = await getLocalizedEntry('colophonTechnologies', locale)

const { headline, groups } = technologies.data

const isExternal = (href: string) => href.startsWith('http')
---

<section class="py-12">
  <div class="wrapper">
    <div class="mx-auto flex w-full max-w-4xl flex-col gap-7">
      <h2 data-enter="block" class="text-heading text-foreground">
        <span class="mr-2 text-secondary" aria-hidden="true">
          #
        </span>
        {headline}
      </h2>
      <div class="flex flex-col border-b border-border">
        {groups.map((group) => (
          <div
            data-enter="block"
            class="flex flex-col gap-2 border-t border-border py-7 md:flex-row md:gap-12"
          >
            <h3 class="text-label text-muted-foreground uppercase md:mt-1.5 md:w-40 md:shrink-0">
              {group.label}
            </h3>
            <div class="flex max-w-2xl flex-col gap-4 text-body leading-relaxed text-muted-foreground">
              {group.paragraphs.map((paragraph) => (
                <p class="text-pretty">
                  {paragraph.map((segment) =>
                    segment.href ? (
                      <a
                        href={segment.href}
                        target={isExternal(segment.href) ? '_blank' : undefined}
                        rel={
                          isExternal(segment.href)
                            ? 'noopener noreferrer'
                            : undefined
                        }
                        class="font-medium text-primary underline underline-offset-4"
                      >
                        {segment.text}
                      </a>
                    ) : (
                      segment.text
                    ),
                  )}
                </p>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
