---
import { cn } from '~/helpers/classnames'
import { parseLocale } from '~/helpers/locale'
import { getLocalizedEntry } from '~/services/localized'

const locale = parseLocale(Astro.currentLocale)
const technologies = await getLocalizedEntry('colophonTechnologies', locale)

const { headline, groups } = technologies.data

const isExternal = (href: string) => href.startsWith('http')
---

<section class="py-8 md:py-12">
  <div class="wrapper">
    <div class="mx-auto flex w-full max-w-2xl flex-col gap-8">
      <h2 data-enter="block" class="text-heading text-foreground">
        {headline}
      </h2>
      <div class="flex flex-col divide-y divide-border">
        {groups.map((group) => (
          <div
            data-enter="block"
            class="flex flex-col gap-2 py-6 first:pt-0 last:pb-0 md:flex-row md:gap-8"
          >
            <h3 class="text-title text-foreground md:w-32 md:shrink-0">
              {group.label}
            </h3>
            <div class="flex flex-col gap-4 text-muted-foreground">
              {group.paragraphs.map((paragraph) => (
                <p class="text-pretty">
                  {paragraph.map((segment) =>
                    segment.href ? (
                      <a
                        href={segment.href}
                        target={isExternal(segment.href) ? '_blank' : undefined}
                        rel={
                          isExternal(segment.href)
                            ? 'noopener noreferrer'
                            : undefined
                        }
                        class={cn(
                          'text-primary underline decoration-primary/40 underline-offset-4 hover:decoration-primary',
                        )}
                      >
                        {segment.text}
                      </a>
                    ) : (
                      segment.text
                    ),
                  )}
                </p>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
