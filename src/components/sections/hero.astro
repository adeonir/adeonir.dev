---
import { getEntry } from 'astro:content'

import { buttonVariants } from '~/components/ui/button'
import { cn } from '~/helpers/classnames'

const hero = await getEntry('hero', 'hero')

if (!hero) {
  throw new Error('Missing hero/hero entry')
}

const { display, tagline, description, actions } = hero.data
---

<section>
  <h1 class="mt-6 flex flex-col font-extrabold tracking-tight text-foreground">
    <span class="text-3xl sm:text-4xl lg:text-5xl">{display.greeting}</span>
    <span class="text-5xl leading-none sm:text-7xl lg:text-8xl">
      {display.name}
    </span>
  </h1>
  <p
    class="mt-6 max-w-2xl text-2xl font-semibold text-pretty text-foreground sm:text-3xl lg:text-4xl"
  >
    {
      tagline.map((segment) => (
        <>
          {segment.highlight ? (
            <span class="text-secondary">{segment.text}</span>
          ) : (
            segment.text
          )}
          {segment.break && <br class="hidden sm:block" />}
        </>
      ))
    }
  </p>
  <div
    class="mt-12 flex flex-col gap-8 md:flex-row md:items-end md:justify-between"
  >
    <div class="flex max-w-2xl flex-col gap-4">
      {
        description.map((paragraph) => (
          <p class="text-body leading-relaxed text-pretty text-muted-foreground">
            {paragraph}
          </p>
        ))
      }
    </div>
    <a
      href={actions.secondary.href}
      class={cn(
        buttonVariants({ variant: 'default', size: 'default' }),
        'shrink-0',
      )}
    >
      {actions.secondary.label}
    </a>
  </div>
</section>
