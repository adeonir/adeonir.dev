---
import { getEntry } from 'astro:content'

import { buttonVariants } from '~/components/ui/button'
import { Eyebrow } from '~/components/ui/eyebrow'
import { cn } from '~/helpers/classnames'

const hero = await getEntry('hero', 'hero')

if (!hero) {
  throw new Error('Missing hero/hero entry')
}

const { eyebrow, display, tagline, description, actions } = hero.data
---

<section
  class="-mt-16 -mb-16 flex min-h-[calc(100dvh-4rem)] flex-col items-center justify-center text-center md:-mt-24 md:-mb-24"
>
  <Eyebrow>{eyebrow}</Eyebrow>
  <h1
    class="mt-4 text-5xl leading-[0.92] font-extrabold tracking-tight text-foreground sm:mt-5 sm:text-7xl lg:text-[7rem]"
  >
    {display}
  </h1>
  <p
    class="mt-6 max-w-3xl text-2xl font-semibold text-balance text-foreground sm:mt-10 sm:text-3xl lg:text-4xl"
  >
    {
      tagline.map((segment) => (
        <>
          {segment.highlight ? (
            <span class="text-secondary">{segment.text}</span>
          ) : (
            segment.text
          )}
          {segment.break && <br class="hidden sm:block" />}
        </>
      ))
    }
  </p>
  <div class="mt-3 flex max-w-xl flex-col gap-2 sm:mt-4">
    {
      description.map((paragraph) => (
        <p class="text-body leading-relaxed text-pretty text-muted-foreground">
          {paragraph}
        </p>
      ))
    }
  </div>
  <a
    href={actions.secondary.href}
    class={cn(
      buttonVariants({ variant: 'default', size: 'default' }),
      'mt-10 sm:mt-14',
    )}
  >
    {actions.secondary.label}
  </a>
</section>
