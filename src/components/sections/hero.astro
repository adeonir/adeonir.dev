---
import { getEntry } from 'astro:content'

import { buttonVariants } from '~/components/ui/button'
import { Eyebrow } from '~/components/ui/eyebrow'
import { cn } from '~/helpers/classnames'
import IconArrowDown from '~icons/tabler/arrow-narrow-down'

const hero = await getEntry('hero', 'hero')

if (!hero) {
  throw new Error('Missing hero/hero entry')
}

const { eyebrow, display, tagline, description, actions, scroll } = hero.data
---

<section
  class="relative flex min-h-[calc(100dvh-6rem)] flex-col items-center justify-center pb-16 text-center [--scale-in:0.98] md:pb-24"
>
  <div class="wrapper flex flex-col items-center">
    <Eyebrow className="[--blur-in:var(--blur-xs)] motion-safe:animate-enter"
      >{eyebrow}</Eyebrow
    >
    <h1
      class="mt-4 text-5xl leading-[0.92] font-extrabold text-foreground [--blur-in:var(--blur-lg)] motion-safe:animate-enter motion-safe:[animation-delay:70ms] sm:mt-5 sm:text-7xl lg:text-[7rem]"
    >
      {display}
    </h1>
    <p
      class="mt-6 max-w-3xl text-2xl font-semibold text-balance text-foreground [--blur-in:var(--blur-sm)] motion-safe:animate-enter motion-safe:[animation-delay:140ms] sm:mt-10 sm:text-3xl lg:text-4xl"
    >
      {
        tagline.map((segment) => (
          <>
            {segment.highlight ? (
              <span class="text-secondary">{segment.text}</span>
            ) : (
              segment.text
            )}
          </>
        ))
      }
    </p>
    <p
      class="mt-3 max-w-3xl text-subtitle leading-relaxed text-pretty text-muted-foreground [--blur-in:var(--blur-xs)] motion-safe:animate-enter motion-safe:[animation-delay:210ms] sm:mt-4"
    >
      {description}
    </p>
    <a
      href={actions.secondary.href}
      class={cn(
        buttonVariants({ variant: 'default', size: 'default' }),
        'mt-10 [--blur-in:0px] motion-safe:animate-enter motion-safe:[animation-delay:280ms] sm:mt-14',
      )}
    >
      {actions.secondary.label}
    </a>
  </div>
  <div
    class="absolute bottom-8 hidden flex-col items-center gap-2 font-mono text-caption text-muted-foreground/73 [--blur-in:var(--blur-xs)] motion-safe:animate-enter motion-safe:[animation-delay:350ms] sm:flex light:text-muted-foreground/91"
  >
    {scroll}
    <IconArrowDown className="size-4 animate-bounce" aria-hidden="true" />
  </div>
</section>
