---
import { getEntry } from 'astro:content'

import { buttonVariants } from '~/components/ui/button'
import { Eyebrow } from '~/components/ui/eyebrow'
import { cn } from '~/helpers/classnames'
import IconArrowDown from '~icons/tabler/arrow-narrow-down'

const hero = await getEntry('hero', 'hero')

if (!hero) {
  throw new Error('Missing hero/hero entry')
}

const { eyebrow, display, tagline, description, actions, scroll } = hero.data
---

<section
  class="relative section-escape flex min-h-[calc(100dvh-4rem)] flex-col items-center justify-center text-center"
>
  <Eyebrow>{eyebrow}</Eyebrow>
  <h1
    class="mt-4 text-5xl leading-[0.92] font-extrabold text-foreground sm:mt-5 sm:text-7xl lg:text-[7rem]"
  >
    {display}
  </h1>
  <p
    class="mt-6 max-w-3xl text-2xl font-semibold text-balance text-foreground sm:mt-10 sm:text-3xl lg:text-4xl"
  >
    {
      tagline.map((segment) => (
        <>
          {segment.highlight ? (
            <span class="text-secondary">{segment.text}</span>
          ) : (
            segment.text
          )}
        </>
      ))
    }
  </p>
  <p
    class="mt-3 max-w-3xl text-subtitle leading-relaxed text-pretty text-muted-foreground sm:mt-4"
  >
    {description}
  </p>
  <a
    href={actions.secondary.href}
    class={cn(
      buttonVariants({ variant: 'default', size: 'default' }),
      'mt-10 sm:mt-14',
    )}
  >
    {actions.secondary.label}
  </a>
  <div
    class="absolute bottom-8 hidden flex-col items-center gap-2 font-mono text-caption text-muted-foreground/73 sm:flex light:text-muted-foreground/91"
  >
    {scroll}
    <IconArrowDown className="size-4 animate-bounce" aria-hidden="true" />
  </div>
</section>
