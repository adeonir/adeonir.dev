---
import { Image } from 'astro:assets'
import { getRelativeLocaleUrl } from 'astro:i18n'

import presenting from '~/assets/characters/presenting.png'
import { Link } from '~/components/ui/link'
import { parseLocale } from '~/helpers/locale'
import { getLocalizedEntry } from '~/services/localized'
import type { ProjectNameSegment } from '~/schemas/project/content'

interface Props {
  kind: string
  category: string
  name: string
  nameSegments?: ProjectNameSegment[]
  summary: string
  url?: string
  repository?: string
}

const { kind, category, name, nameSegments, summary, url, repository } =
  Astro.props

const locale = parseLocale(Astro.currentLocale)
const header = await getLocalizedEntry('projectHeader', locale)

const { back, links } = header.data
const indexHref = getRelativeLocaleUrl(locale, '/projects')

const actions = [
  { href: url, label: links.site },
  { href: repository, label: links.repository },
].filter((action): action is { href: string; label: string } =>
  Boolean(action.href),
)
---

<header id="project-header" class="pt-8 md:pt-16">
  <div class="wrapper">
    <div class="mx-auto flex w-full max-w-2xl flex-col gap-16">
      <Link data-enter="block" href={indexHref} icon="arrow-left" size="small">
        {back}
      </Link>
      <div class="flex flex-col gap-6 md:flex-row md:items-start md:gap-8">
        <div class="flow-root space-y-6 md:flex md:flex-col md:gap-6 md:space-y-0">
          <p
            data-enter="block"
            class="text-label text-muted-foreground uppercase"
          >
            {category} · {kind}
          </p>
          <h1
            data-enter="block"
            class="text-5xl leading-none font-extrabold tracking-tight text-pretty text-foreground md:text-6xl"
          >
            {nameSegments?.map((segment) =>
              segment.highlight ? (
                <span class="text-secondary">{segment.text}</span>
              ) : (
                segment.text
              ),
            ) ?? name}
          </h1>
          <p
            data-enter="block"
            class="text-body leading-relaxed text-pretty text-muted-foreground"
          >
            {summary}
          </p>
          {actions.length > 0 && (
            <div data-enter="block" class="mt-2 flex flex-wrap gap-6">
              {actions.map((action) => (
                <Link href={action.href} size="small">
                  {action.label}
                </Link>
              ))}
            </div>
          )}
        </div>
        <Image
          data-enter="block"
          src={presenting}
          alt=""
          loading="lazy"
          decoding="async"
          widths={[204, 408]}
          sizes="204px"
          class="-mt-12 hidden h-80 w-auto shrink-0 md:block"
        />
      </div>
    </div>
  </div>
</header>
