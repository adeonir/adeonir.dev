---
import { type CollectionEntry, render } from 'astro:content'

interface Props {
  entry: CollectionEntry<'projectsContent'>
}

const { entry } = Astro.props
const { Content } = await render(entry)
---

<section class="py-8 md:py-10">
  <div class="wrapper">
    <div class="prose">
      <Content />
    </div>
  </div>
</section>
