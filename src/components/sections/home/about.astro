---
import { Image } from 'astro:assets'

import working from '~/assets/characters/working.png'
import { Eyebrow } from '~/components/ui/eyebrow'
import { buttonVariants } from '~/components/ui/button-variants'
import { cn } from '~/helpers/classnames'
import { parseLocale } from '~/helpers/content'
import { getLocalizedEntry } from '~/services/localized'
import IconArrowUpRight from '~icons/tabler/arrow-up-right'

const locale = parseLocale(Astro.currentLocale)
const about = await getLocalizedEntry('homeAbout', locale)

const { eyebrow, headline, body, bio } = about.data
---

<section id="about" class="pt-16 pb-4 md:pt-20 md:pb-8">
  <div class="wrapper">
    <div class="mt-12 grid grid-cols-1 gap-12 md:grid-cols-5">
      <div class="flex flex-col gap-6 md:col-span-2">
        <Eyebrow data-enter="block" variant="muted">{eyebrow}</Eyebrow>
        <h2 data-enter="block" class="text-display text-pretty text-foreground">
          {
            headline.map((segment) => (
              <>
                {segment.highlight ? (
                  <span class="text-secondary">{segment.text}</span>
                ) : (
                  <span class="text-muted-foreground">{segment.text}</span>
                )}
              </>
            ))
          }
        </h2>
        <p
          data-enter="block"
          class="text-body leading-relaxed text-pretty text-muted-foreground"
        >
          {body}
        </p>
        <Image
          src={working}
          alt=""
          loading="lazy"
          decoding="async"
          widths={[196, 392]}
          sizes="196px"
          class="hidden h-64 w-auto md:block"
          data-enter="block"
        />
      </div>
      <div class="flex flex-col gap-6 md:col-span-3 md:pt-14">
        {
          bio.map((paragraph, index) => (
            <p
              data-enter="block"
              class={cn(
                'leading-relaxed text-pretty',
                index === 0
                  ? 'text-subtitle text-foreground'
                  : 'text-body text-muted-foreground',
              )}
            >
              {paragraph.map((segment) =>
                segment.href ? (
                  <a
                    href={segment.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={cn(
                      'group gap-1',
                      buttonVariants({ variant: 'link', size: 'inline' }),
                    )}
                  >
                    {segment.text}
                    <IconArrowUpRight
                      className="size-4 shrink-0 transition-transform duration-200 motion-safe:group-hover:-translate-y-0.5"
                      aria-hidden="true"
                    />
                  </a>
                ) : (
                  segment.text
                ),
              )}
            </p>
          ))
        }
      </div>
    </div>
  </div>
</section>
