---
import NarrationPlayer from '~/components/narration-player.astro'
import { Eyebrow } from '~/components/ui/eyebrow'
import { parseLocale } from '~/helpers/locale'
import { getLocalizedEntry } from '~/services/localized'

const locale = parseLocale(Astro.currentLocale)
const expertise = await getLocalizedEntry('homeExpertise', locale)

const { eyebrow, headline, body, items } = expertise.data
---

<section id="expertise" class="pt-16 pb-4 md:pt-20 md:pb-8">
  <div class="wrapper">
    <div class="mt-12 grid grid-cols-1 gap-12 md:grid-cols-5">
      <div class="flex flex-col gap-6 md:col-span-2">
        <div data-enter="block">
          <Eyebrow variant="muted">{eyebrow}</Eyebrow>
        </div>
        <h2 data-enter="block" class="text-display text-pretty text-foreground">
          {headline.map((segment) => (
            <>
              {segment.highlight ? (
                <span class="text-secondary">{segment.text}</span>
              ) : (
                segment.text
              )}
            </>
          ))}
        </h2>
        <p
          data-enter="block"
          class="text-body leading-relaxed text-pretty text-muted-foreground"
        >
          {body}
        </p>
        <div data-enter="block">
          <NarrationPlayer section="expertise" />
        </div>
      </div>
      <div class="space-y-6 md:col-span-3 md:flex md:flex-col md:gap-6 md:space-y-0 md:pt-14">
        <ul class="space-y-8">
          {items.map((item) => (
            <li
              data-enter="block"
              class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-2"
            >
              <span aria-hidden="true" class="text-code text-secondary">
                #
              </span>
              <p class="text-code text-foreground">{item.title}</p>
              <p class="col-start-2 text-body leading-relaxed text-pretty text-muted-foreground">
                {item.description}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
