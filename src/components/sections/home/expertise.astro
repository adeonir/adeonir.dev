---
import { getImage, Image } from 'astro:assets'

import carryingBlocks from '~/assets/characters/carrying-blocks.png'
import { Eyebrow } from '~/components/ui/eyebrow'
import { parseLocale } from '~/helpers/content'
import { getLocalizedEntry } from '~/services/localized'

const locale = parseLocale(Astro.currentLocale)
const expertise = await getLocalizedEntry('homeExpertise', locale)

const { eyebrow, headline, body, items } = expertise.data
const carryingBlocksMobile = await getImage({
  src: carryingBlocks,
  width: 309,
  height: 480,
})
---

<section id="expertise" class="pt-16 pb-4 md:pt-20 md:pb-8">
  <div class="wrapper">
    <div class="mt-12 grid grid-cols-1 gap-12 md:grid-cols-5">
      <div class="flex flex-col gap-6 md:col-span-2">
        <Eyebrow data-enter="block" variant="muted">{eyebrow}</Eyebrow>
        <h2 data-enter="block" class="text-display text-pretty text-foreground">
          {
            headline.map((segment) => (
              <>
                {segment.highlight ? (
                  <span class="text-secondary">{segment.text}</span>
                ) : (
                  segment.text
                )}
              </>
            ))
          }
        </h2>
        <p
          data-enter="block"
          class="text-body leading-relaxed text-pretty text-muted-foreground"
        >
          {body}
        </p>
        <Image
          src={carryingBlocks}
          alt=""
          loading="lazy"
          decoding="async"
          widths={[206, 412]}
          sizes="206px"
          class="hidden h-80 w-auto self-start md:block md:pl-8"
          data-enter="block"
        />
      </div>
      <div
        class="flow-root space-y-6 md:col-span-3 md:flex md:flex-col md:gap-6 md:space-y-0 md:pt-14"
      >
        <img
          src={carryingBlocksMobile.src}
          width={carryingBlocksMobile.attributes.width}
          height={carryingBlocksMobile.attributes.height}
          alt=""
          loading="lazy"
          decoding="async"
          class="float-left mr-4 mb-2 h-60 w-auto md:hidden"
          style={`shape-outside: url(${carryingBlocksMobile.src}); shape-margin: 2rem`}
          data-enter="block"
        />
        <ul class="space-y-8">
          {
            items.map((item) => (
              <li data-enter="block" class="space-y-2">
                <p class="text-code text-foreground">
                  <span
                    aria-hidden="true"
                    class="mr-3 inline-block size-1.5 bg-secondary align-middle"
                  />
                  {item.title}
                </p>
                <p class="pl-4.5 text-body leading-relaxed text-pretty text-muted-foreground">
                  {item.description}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
