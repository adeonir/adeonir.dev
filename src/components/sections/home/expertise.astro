---
import IconPlus from '~icons/tabler/plus'
import NarrationPlayer from '~/components/narration-player.astro'
import { parseLocale } from '~/helpers/locale'
import { getLocalizedEntry } from '~/services/localized'

const locale = parseLocale(Astro.currentLocale)
const expertise = await getLocalizedEntry('homeExpertise', locale)

const { headline, body, items } = expertise.data
---

<section id="expertise" class="pt-16 pb-4 md:pt-20 md:pb-8">
  <div class="wrapper">
    <div class="mt-12 grid grid-cols-1 gap-12 md:grid-cols-5">
      <div class="flex flex-col gap-6 md:col-span-2">
        <h2 data-enter="block" class="text-display text-pretty text-foreground">
          {headline.map((segment) => (
            <>
              {segment.highlight ? (
                <span class="text-secondary">{segment.text}</span>
              ) : (
                segment.text
              )}
            </>
          ))}
        </h2>
        <p
          data-enter="block"
          class="text-body leading-relaxed text-pretty text-muted-foreground"
        >
          {body}
        </p>
        <div data-enter="block" class="mt-4 sm:mt-6">
          <NarrationPlayer section="expertise" />
        </div>
      </div>
      <div class="md:col-span-3">
        <div data-enter="block" class="border-t border-border">
          {items.map((item, index) => (
            <details
              name="expertise"
              open={index === 0}
              class="expertise-item group/item border-b border-border py-2"
            >
              <summary class="group/summary flex cursor-pointer group-open/item:pointer-events-none -mx-4 list-none items-center justify-between gap-6 rounded-xl px-4 py-5 transition-[background-color,translate] duration-300 ease-out hover:bg-card focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none [&::-webkit-details-marker]:hidden">
                <span class="text-2xl font-semibold text-muted-foreground transition-[color,translate] duration-300 ease-out group-open/item:text-foreground group-hover/summary:translate-x-1 group-hover/summary:text-foreground sm:text-3xl">
                  {item.title}
                </span>
                <span
                  aria-hidden="true"
                  class="grid size-10 shrink-0 place-items-center rounded-full border border-border text-muted-foreground transition duration-300 ease-out group-open/item:rotate-45 group-open/item:text-foreground group-hover/summary:border-primary group-hover/summary:text-primary"
                >
                  <IconPlus className="size-5" />
                </span>
              </summary>
              <p class="max-w-prose pb-6 text-body leading-relaxed text-pretty text-muted-foreground">
                {item.description}
              </p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // one area stays open at all times: clicking the open summary does not close it
  for (const summary of document.querySelectorAll<HTMLElement>(
    '.expertise-item > summary',
  )) {
    summary.addEventListener('click', (event) => {
      if ((summary.parentElement as HTMLDetailsElement).open)
        event.preventDefault()
    })
  }
</script>

<style>
  .expertise-item {
    interpolate-size: allow-keywords;
  }

  .expertise-item::details-content {
    height: 0;
    overflow: clip;
    opacity: 0;
    transition:
      height 400ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 300ms ease-out,
      content-visibility 400ms allow-discrete;
  }

  .expertise-item[open]::details-content {
    height: auto;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .expertise-item::details-content {
      transition: none;
    }
  }
</style>
