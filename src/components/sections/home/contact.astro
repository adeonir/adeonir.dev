---
import { ContactForm } from '~/components/islands/home/contact-form'
import { Eyebrow } from '~/components/ui/eyebrow'
import { parseLocale } from '~/helpers/locale'
import { getLocalizedEntry } from '~/services/localized'
import IconFolder from '~icons/tabler/folder'

const locale = parseLocale(Astro.currentLocale)
const contact = await getLocalizedEntry('homeContact', locale)

const { eyebrow, title, body, socialLabel, social, form } = contact.data
---

<section id="contact" class="pt-16 pb-16 md:pt-20">
  <div class="wrapper">
    <div class="mt-12 grid grid-cols-1 gap-12 md:grid-cols-5">
      <div class="flex flex-col gap-6 md:col-span-2">
        <Eyebrow data-enter="block">{eyebrow}</Eyebrow>
        <h2 data-enter="block" class="text-display text-pretty text-foreground">
          {title.map((segment) => (
            <>
              {segment.highlight ? (
                <span class="text-secondary">{segment.text}</span>
              ) : (
                segment.text
              )}
            </>
          ))}
        </h2>
        <p
          data-enter="block"
          class="text-body leading-relaxed text-pretty text-muted-foreground"
        >
          {body}
        </p>
        <div data-enter="block" class="mt-6 flex flex-col gap-2">
          <p class="inline-flex items-center gap-2 text-code text-foreground">
            <IconFolder
              className="size-4 shrink-0 text-muted-foreground"
              aria-hidden="true"
            />
            <span>contact/</span>
          </p>
          <ul
            aria-label={socialLabel}
            class="relative flex flex-col gap-1 pl-5 before:absolute before:top-0 before:bottom-2.5 before:left-1.5 before:w-2 before:rounded-bl-lg before:border-b before:border-l before:border-border"
          >
            {social.map((channel) => {
              const external = channel.platform !== 'email'
              return (
                <li data-enter="row" class="flex gap-2 text-code">
                  <span class="text-secondary" aria-hidden="true">
                    -
                  </span>
                  <a
                    href={channel.link}
                    class="-mx-1 rounded-sm px-1 text-muted-foreground transition hover:text-primary focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background focus-visible:outline-none"
                    {...(external
                      ? { target: '_blank', rel: 'noopener noreferrer' }
                      : {})}
                  >
                    {channel.label}
                  </a>
                </li>
              )
            })}
          </ul>
        </div>
      </div>
      <div class="flex flex-col gap-6 md:col-span-3 md:pt-14">
        <div data-enter="block">
          <ContactForm content={form} locale={locale} client:visible />
        </div>
      </div>
    </div>
  </div>
</section>
