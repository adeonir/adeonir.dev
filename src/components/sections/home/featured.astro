---
import type { ImageMetadata } from 'astro'
import { type CollectionEntry, getCollection } from 'astro:content'
import { getRelativeLocaleUrl } from 'astro:i18n'

import ProjectCard from '~/components/sections/home/card.astro'
import { buttonVariants } from '~/components/ui/button-variants'
import { Eyebrow } from '~/components/ui/eyebrow'
import { cn } from '~/helpers/classnames'
import { parseLocale } from '~/helpers/content'
import { assertFeaturedBounds } from '~/helpers/projects'
import { getLocalizedEntry } from '~/services/localized'
import IconArrowRight from '~icons/tabler/arrow-right'
import IconFolder from '~icons/tabler/folder'

type ProjectEntry = CollectionEntry<'projectsContent'>

type FeaturedEntry = ProjectEntry & {
  data: { featured: number; cover: ImageMetadata }
}

const locale = parseLocale(Astro.currentLocale)
const projects = await getLocalizedEntry('homeProjects', locale)

const { eyebrow, headline, body, seeAll, empty } = projects.data

const entries = await getCollection('projectsContent', (entry) =>
  entry.id.startsWith(`${locale}/`),
)

if (entries.length > 0) {
  assertFeaturedBounds(entries)
}

const indexHref = getRelativeLocaleUrl(locale, '/projects')

const featured = entries
  .filter((entry): entry is FeaturedEntry => entry.data.featured !== undefined)
  .sort((a, b) => a.data.featured - b.data.featured)
  .map((entry) => ({
    ...entry.data,
    href: getRelativeLocaleUrl(
      locale,
      `/projects/${entry.id.slice(locale.length + 1)}`,
    ),
  }))
---

<section id="projects" class="pt-16 pb-4 md:pt-20 md:pb-8">
  <div class="wrapper">
    <div class="mt-12 grid grid-cols-1 gap-12 md:grid-cols-5">
      <div class="flex flex-col gap-6 md:col-span-2">
        <Eyebrow data-enter="block" variant="muted">{eyebrow}</Eyebrow>
        <h2 data-enter="block" class="text-display text-pretty text-foreground">
          {
            headline.map((segment) => (
              <>
                {segment.highlight ? (
                  <span class="text-secondary">{segment.text}</span>
                ) : (
                  segment.text
                )}
              </>
            ))
          }
        </h2>
        <p
          data-enter="block"
          class="text-body leading-relaxed text-pretty text-muted-foreground"
        >
          {body}
        </p>
      </div>
      <div class="md:col-span-3 md:pt-14">
        {
          featured.length > 0 ? (
            <div class="flex flex-col gap-8">
              {featured.map((project) => (
                <ProjectCard {...project} />
              ))}
            </div>
          ) : (
            <div
              data-enter="block"
              class="flex aspect-21/9 flex-col items-center justify-center gap-4 rounded-2xl border border-border bg-card p-6 text-center"
            >
              <IconFolder
                className="size-7 shrink-0 text-muted-foreground opacity-70"
                aria-hidden="true"
              />
              <p class="max-w-[40ch] text-base leading-normal text-pretty text-muted-foreground">
                {empty.map((segment) =>
                  segment.href ? (
                    <a
                      href={segment.href}
                      class={buttonVariants({
                        variant: 'link',
                        size: 'inline',
                      })}
                    >
                      {segment.text}
                    </a>
                  ) : (
                    segment.text
                  ),
                )}
              </p>
            </div>
          )
        }
        {
          entries.length > 0 && (
            <div data-enter="block" class="mt-8 flex justify-end">
              <a
                href={indexHref}
                class={cn(
                  'group gap-2',
                  buttonVariants({ variant: 'link', size: 'inline' }),
                )}
              >
                {seeAll}
                <IconArrowRight
                  className="size-4 shrink-0 transition-transform duration-200 motion-safe:group-hover:translate-x-1"
                  aria-hidden="true"
                />
              </a>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
