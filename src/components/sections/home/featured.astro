---
import type { ImageMetadata } from 'astro'
import { type CollectionEntry, getCollection } from 'astro:content'
import { getRelativeLocaleUrl } from 'astro:i18n'

import ProjectCard from '~/components/project-card.astro'
import { buttonVariants } from '~/components/ui/button-variants'
import { cn } from '~/helpers/classnames'
import { parseLocale } from '~/helpers/locale'
import { assertFeaturedBounds, sortByLaunch } from '~/helpers/projects'
import { getLocalizedEntry } from '~/services/localized'
import IconArrowRight from '~icons/tabler/arrow-right'
import IconFolder from '~icons/tabler/folder'

type ProjectEntry = CollectionEntry<'projectContent'>

type FeaturedEntry = ProjectEntry & {
  data: { featured: true; cover: ImageMetadata; coverAlt: string }
}

const locale = parseLocale(Astro.currentLocale)
const projects = await getLocalizedEntry('homeProjects', locale)

const { headline, body, seeAll, empty } = projects.data

const entries = await getCollection('projectContent', (entry) =>
  entry.id.startsWith(`${locale}/`),
)

if (entries.length > 0) {
  assertFeaturedBounds(entries)
}

const indexHref = getRelativeLocaleUrl(locale, '/projects')

const featured = sortByLaunch(
  entries.filter(
    (entry): entry is FeaturedEntry => entry.data.featured === true,
  ),
).map((entry) => ({
  ...entry.data,
  href: getRelativeLocaleUrl(
    locale,
    `/projects/${entry.id.slice(locale.length + 1)}`,
  ),
}))
---

<section id="projects" class="pt-16 pb-4 md:pt-20 md:pb-8">
  <div class="wrapper">
    <div class="@container mt-12 grid grid-cols-1 gap-12 md:grid-cols-5">
      <div
        data-featured-title
        class="sticky top-28 z-10 mb-(--featured-stack-h) flex flex-col gap-6 self-start bg-background pb-12 md:z-auto md:mb-0 md:bg-transparent md:pb-0 md:col-span-2 md:min-h-[calc(33.75cqw+6.325rem+100px)]"
      >
        <h2 class="text-display text-pretty text-foreground">
          {headline.map((segment) => (
            <>
              {segment.highlight ? (
                <span class="text-secondary">{segment.text}</span>
              ) : (
                segment.text
              )}
            </>
          ))}
        </h2>
        <p class="text-body leading-relaxed text-pretty text-muted-foreground">
          {body}
        </p>
        {entries.length > 0 && (
          <a
            href={indexHref}
            class={cn(
              'group gap-2 self-start',
              buttonVariants({ variant: 'link', size: 'inline' }),
              'hidden md:inline-flex',
            )}
          >
            {seeAll}
            <IconArrowRight className="size-4 shrink-0 transition-transform duration-200 motion-safe:group-hover:translate-x-1" />
          </a>
        )}
      </div>
      <div class="relative z-20 -mt-[calc(var(--featured-stack-h,0px)+3rem)] md:mt-0 [--stack-top:calc(7rem+var(--featured-title-h,0px))] md:z-auto md:col-span-3 md:[--stack-top:7rem]">
        {featured.length > 0 ? (
          <div class="flex flex-col gap-8">
            {featured.map((project, index) => (
              <div
                data-stack-card
                class="sticky origin-top"
                style={`top: calc(var(--stack-top) + ${index} * 3.5rem); padding-bottom: calc(${featured.length - 1 - index} * 3.5rem); margin-top: ${index === 0 ? 0 : `calc(${featured.length - index} * -3.5rem)`}`}
              >
                <ProjectCard
                  {...project}
                  sizes="(min-width: 1280px) 740px, (min-width: 768px) 60vw, calc(100vw - 3rem)"
                />
              </div>
            ))}
          </div>
        ) : (
          <div
            data-enter="block"
            class="flex aspect-video flex-col items-center justify-center gap-4 rounded-2xl border border-border bg-card p-6 text-center"
          >
            <IconFolder className="size-7 shrink-0 text-muted-foreground opacity-70" />
            <p class="max-w-[40ch] text-base leading-normal text-pretty text-muted-foreground">
              {empty.map((segment) =>
                segment.href ? (
                  <a
                    href={segment.href}
                    class={buttonVariants({
                      variant: 'link',
                      size: 'inline',
                    })}
                  >
                    {segment.text}
                  </a>
                ) : (
                  segment.text
                ),
              )}
            </p>
          </div>
        )}
      </div>
    </div>
    {entries.length > 0 && (
      <a
        href={indexHref}
        class={cn(
          'group mt-12 gap-2',
          buttonVariants({ variant: 'link', size: 'inline' }),
          'md:hidden',
        )}
      >
        {seeAll}
        <IconArrowRight className="size-4 shrink-0 transition-transform duration-200 motion-safe:group-hover:translate-x-1" />
      </a>
    )}
  </div>
</section>
