---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

import IconArrowRight from '~icons/tabler/arrow-right'

interface Props {
  name: string
  category: string
  launch: string
  summary: string
  cover: ImageMetadata
  href: string
}

const { name, category, launch, summary, cover, href } = Astro.props

const year = launch.slice(0, 4)
---

<a
  href={href}
  class="group block rounded-2xl transition-shadow duration-200 focus-visible:ring-4 focus-visible:ring-ring/50 focus-visible:ring-offset-2 focus-visible:ring-offset-background focus-visible:outline-none"
>
  <article
    data-enter="block"
    class="relative isolate flex aspect-21/9 overflow-hidden rounded-2xl border border-border"
  >
    <Image
      src={cover}
      alt=""
      loading="lazy"
      decoding="async"
      widths={[480, 640, 960, 1280]}
      sizes="(min-width: 768px) 640px, calc(100vw - 3rem)"
      class="absolute inset-0 -z-10 size-full object-cover object-[70%_center] transition-transform duration-500 ease-out group-focus-within:scale-103 group-hover:scale-103"
    />
    <div
      class="flex h-full w-46/100 flex-col justify-end gap-2 bg-linear-to-t from-sunken to-sunken/50 to-50% p-6 backdrop-blur-sm"
    >
      <IconArrowRight
        className="absolute top-6 right-6 size-5 text-foreground transition-[color,transform,translate] duration-200 group-focus-within:translate-x-1 group-hover:translate-x-2 group-hover:text-primary"
        aria-hidden="true"
      />
      <p
        class="font-mono text-xs tracking-widest text-muted-foreground uppercase"
      >
        {category} · {year}
      </p>
      <h3 class="text-title font-bold text-pretty text-foreground">{name}</h3>
      <p class="line-clamp-2 text-caption text-pretty text-muted-foreground/80">
        {summary}
      </p>
    </div>
  </article>
</a>
