---
import { buttonVariants } from '~/components/ui/button-variants'
import { Eyebrow } from '~/components/ui/eyebrow'
import { cn } from '~/helpers/classnames'
import { parseLocale } from '~/helpers/content'
import { getLocalizedEntry } from '~/services/localized'
import IconArrowDown from '~icons/tabler/arrow-narrow-down'

const locale = parseLocale(Astro.currentLocale)
const hero = await getLocalizedEntry('homeHero', locale)

const { eyebrow, display, tagline, description, actions, scroll } = hero.data
---

<section
  id="hero"
  class="relative flex min-h-[calc(100dvh-6rem)] flex-col items-center justify-center pt-8 pb-24 text-center [--scale-in:0.98] motion-reduce:[--scale-in:1]"
>
  <div class="wrapper flex flex-col items-center">
    <Eyebrow className="animate-enter [--blur-in:var(--blur-xs)]"
      >{eyebrow}</Eyebrow
    >
    <h1
      class="mt-4 animate-enter text-5xl leading-[0.92] font-extrabold text-foreground [--blur-in:var(--blur-lg)] [--enter-opacity:1] [animation-delay:70ms] sm:mt-5 sm:text-7xl lg:text-[7rem]"
    >
      {display}
    </h1>
    <p
      class="mt-6 max-w-3xl animate-enter text-2xl font-semibold text-balance text-foreground [--blur-in:var(--blur-sm)] [animation-delay:140ms] sm:mt-10 sm:text-3xl lg:text-4xl"
    >
      {
        tagline.map((segment) => (
          <>
            {segment.highlight ? (
              <span class="text-secondary">{segment.text}</span>
            ) : (
              segment.text
            )}
          </>
        ))
      }
    </p>
    <p
      class="mt-3 max-w-3xl animate-enter text-subtitle leading-relaxed text-pretty text-muted-foreground [--blur-in:var(--blur-xs)] [animation-delay:210ms] sm:mt-4"
    >
      {description}
    </p>
    <div
      class="mt-10 flex animate-enter flex-wrap items-center justify-center gap-4 [--blur-in:0px] [animation-delay:280ms] sm:mt-14"
    >
      <a
        href={actions.primary.href}
        class={cn(buttonVariants({ variant: 'default', size: 'default' }))}
      >
        {actions.primary.label}
      </a>
      <a
        href={actions.secondary.href}
        class={cn(buttonVariants({ variant: 'outline', size: 'default' }))}
      >
        {actions.secondary.label}
      </a>
    </div>
  </div>
  <div
    class="absolute bottom-8 flex animate-enter flex-col items-center gap-2 font-mono text-caption text-muted-foreground/73 [--blur-in:var(--blur-xs)] [animation-delay:350ms] light:text-muted-foreground/91"
  >
    {scroll}
    <IconArrowDown
      className="size-4 animate-bounce motion-reduce:animate-none"
      aria-hidden="true"
    />
  </div>
</section>
