---
import NarrationPlayer from '~/components/narration-player.astro'
import { buttonVariants } from '~/components/ui/button-variants'
import { cn } from '~/helpers/classnames'
import { parseLocale } from '~/helpers/locale'
import { getLocalizedEntry } from '~/services/localized'

const locale = parseLocale(Astro.currentLocale)
const hero = await getLocalizedEntry('homeHero', locale)

const { display, tagline, availability, actions } = hero.data
---

<section
  id="hero"
  class="relative flex min-h-[calc(100dvh-16rem)] overflow-x-clip flex-col justify-center pt-8 [--scale-in:0.98] motion-reduce:[--scale-in:1]"
>
  <div class="wrapper relative flex flex-col items-start">
    <canvas
      data-hero-fx
      aria-hidden="true"
      class="pointer-events-none absolute top-1/2 right-[calc((100%-100vw)/2)] hidden h-[calc(50%+6rem)] w-[calc(60%+(100vw-100%)/2)] md:block"
    ></canvas>
    <p class="mb-6 inline-flex animate-enter items-center gap-2 rounded-full border-2 border-border px-3 py-1 text-xs font-semibold tracking-widest text-muted-foreground uppercase [--blur-in:0px] sm:mb-8">
      <span aria-hidden="true" class="size-2 rounded-full bg-success"></span>
      {availability.label}
    </p>
    <div class="relative">
      <h1 class="animate-enter text-6xl leading-[0.92] font-extrabold text-foreground [--blur-in:var(--blur-lg)] [--enter-opacity:1] sm:text-7xl md:text-8xl lg:text-9xl">
        {display}
      </h1>
    </div>
    <p class="mt-6 max-w-208 animate-enter text-2xl leading-snug text-pretty text-foreground [--blur-in:var(--blur-sm)] [animation-delay:70ms] sm:mt-8 sm:text-3xl lg:text-4xl">
      {tagline.map((segment) => (
        <>
          {segment.highlight ? (
            <span class="text-secondary">{segment.text}</span>
          ) : (
            segment.text
          )}
        </>
      ))}
    </p>
    <NarrationPlayer
      section="hero"
      class="mt-10 animate-enter [--blur-in:0px] [animation-delay:140ms] sm:mt-12"
    />
    <a
      href={actions.primary.href}
      class={cn(
        'mt-8 animate-enter [--blur-in:0px] [animation-delay:210ms] sm:mt-10',
        buttonVariants({ variant: 'default', size: 'default' }),
      )}
    >
      {actions.primary.label}
    </a>
  </div>
</section>
