---
import AvailabilitySeal from '~/components/availability-seal.astro'
import NarrationPlayer from '~/components/narration-player.astro'
import { buttonVariants } from '~/components/ui/button-variants'
import { cn } from '~/helpers/classnames'
import { parseLocale } from '~/helpers/locale'
import { getLocalizedEntry } from '~/services/localized'

const locale = parseLocale(Astro.currentLocale)
const hero = await getLocalizedEntry('homeHero', locale)

const { display, tagline, availability, actions } = hero.data
---

<section
  id="hero"
  class="relative flex min-h-[calc(100dvh-16rem)] flex-col justify-center pt-8 [--scale-in:0.98] motion-reduce:[--scale-in:1]"
>
  <div class="wrapper relative flex flex-col items-start">
    <canvas
      data-hero-fx
      aria-hidden="true"
      class="pointer-events-none absolute top-1/2 right-0 hidden h-[calc(50%+6rem)] w-3/5 md:block"
    ></canvas>
    <div class="relative">
      <h1 class="animate-enter text-6xl leading-[0.92] font-extrabold text-foreground [--blur-in:var(--blur-lg)] [--enter-opacity:1] sm:text-7xl md:text-8xl lg:text-9xl">
        {display}
      </h1>
      <a
        href={actions.secondary.href}
        class="group absolute -top-36 right-0 size-20 -rotate-16 animate-enter overflow-hidden rounded-full transition [--blur-in:var(--blur-lg)] [animation-delay:210ms] focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background focus-visible:outline-none motion-safe:hover:-rotate-24 xxs:-top-24 xxs:-right-8 xs:-right-24 xs:size-24 lg:-top-28 lg:-right-32 lg:size-28"
      >
        <AvailabilitySeal availability={availability} />
      </a>
    </div>
    <p class="mt-6 max-w-3xl animate-enter text-2xl leading-snug text-pretty text-foreground [--blur-in:var(--blur-sm)] [animation-delay:70ms] sm:mt-8 sm:text-3xl lg:text-4xl">
      {tagline.map((segment) => (
        <>
          {segment.highlight ? (
            <span class="text-secondary">{segment.text}</span>
          ) : (
            segment.text
          )}
        </>
      ))}
    </p>
    <NarrationPlayer
      section="hero"
      class="mt-10 animate-enter [--blur-in:0px] [animation-delay:140ms] sm:mt-12"
    />
    <a
      href={actions.primary.href}
      class={cn(
        'mt-8 animate-enter [--blur-in:0px] [animation-delay:210ms] sm:mt-10',
        buttonVariants({ variant: 'default', size: 'default' }),
      )}
    >
      {actions.primary.label}
    </a>
  </div>
</section>
