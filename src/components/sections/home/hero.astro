---
import AvailabilitySeal from '~/components/availability-seal.astro'
import { buttonVariants } from '~/components/ui/button-variants'
import { Eyebrow } from '~/components/ui/eyebrow'
import { cn } from '~/helpers/classnames'
import { parseLocale } from '~/helpers/content'
import { getLocalizedEntry } from '~/services/localized'

const locale = parseLocale(Astro.currentLocale)
const hero = await getLocalizedEntry('homeHero', locale)

const { eyebrow, display, tagline, description, availability, actions } =
  hero.data
---

<section
  id="hero"
  class="relative flex min-h-[calc(100dvh-6rem)] flex-col items-center justify-center pt-8 text-center [--scale-in:0.98] motion-reduce:[--scale-in:1]"
>
  <div class="wrapper flex flex-col items-center">
    <Eyebrow className="animate-enter [--blur-in:var(--blur-xs)]"
      >{eyebrow}</Eyebrow
    >
    <div class="relative mt-4 sm:mt-5">
      <h1
        class="animate-enter text-5xl leading-[0.92] font-extrabold text-foreground [--blur-in:var(--blur-lg)] [--enter-opacity:1] [animation-delay:70ms] sm:text-7xl lg:text-[7rem]"
      >
        {display}
      </h1>
      <div
        class="absolute -top-36 right-0 size-20 -rotate-16 animate-enter [--blur-in:var(--blur-lg)] [animation-delay:210ms] xxs:-top-24 xxs:-right-8 xs:-right-24 xs:size-24 lg:-top-28 lg:-right-32 lg:size-28"
      >
        <AvailabilitySeal availability={availability} />
      </div>
    </div>
    <p
      class="mt-6 max-w-3xl animate-enter text-2xl font-semibold text-balance text-foreground [--blur-in:var(--blur-sm)] [animation-delay:140ms] sm:mt-10 sm:text-3xl lg:text-4xl"
    >
      {
        tagline.map((segment) => (
          <>
            {segment.highlight ? (
              <span class="text-secondary">{segment.text}</span>
            ) : (
              segment.text
            )}
          </>
        ))
      }
    </p>
    <p
      class="mt-3 max-w-lg animate-enter text-lg leading-relaxed text-pretty text-muted-foreground/80 [--blur-in:var(--blur-xs)] [animation-delay:210ms] sm:mt-4 sm:text-xl lg:max-w-xl lg:text-2xl"
    >
      {description}
    </p>
    <div
      class="mt-10 flex animate-enter flex-wrap items-center justify-center gap-4 [--blur-in:0px] [animation-delay:280ms] sm:mt-14"
    >
      <a
        href={actions.primary.href}
        class={cn(buttonVariants({ variant: 'default', size: 'default' }))}
      >
        {actions.primary.label}
      </a>
      <a
        href={actions.secondary.href}
        class={cn(buttonVariants({ variant: 'outline', size: 'default' }))}
      >
        {actions.secondary.label}
      </a>
    </div>
  </div>
</section>
