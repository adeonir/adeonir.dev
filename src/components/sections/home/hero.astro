---
import IconAstro from '~icons/simple-icons/astro'
import IconClaude from '~icons/simple-icons/claude'
import IconFigma from '~icons/simple-icons/figma'
import IconGhostty from '~icons/simple-icons/ghostty'
import IconNextjs from '~icons/simple-icons/nextdotjs'
import IconReact from '~icons/simple-icons/react'
import IconTailwind from '~icons/simple-icons/tailwindcss'
import IconTypeScript from '~icons/simple-icons/typescript'
import IconVscode from '~icons/simple-icons/visualstudiocode'
import NarrationPlayer from '~/components/narration-player.astro'
import { buttonVariants } from '~/components/ui/button-variants'
import { cn } from '~/helpers/classnames'
import { parseLocale } from '~/helpers/locale'
import { getLocalizedEntry } from '~/services/localized'

const locale = parseLocale(Astro.currentLocale)
const hero = await getLocalizedEntry('homeHero', locale)

const { display, tagline, availability, actions } = hero.data

// Positions come from the canvas frames at 390px (sm), 834px (md), and 1440px (lg).
// x is a percentage of the hero width; y is the rem offset from the hero's vertical middle; size is in rem.
// A badge missing a breakpoint is hidden there.
type Placement = { x: number; y: number; size: number; rotate: number }

const badges: {
  id: string
  depth: number
  Icon: typeof IconReact
  sm?: Placement
  md?: Placement
  lg?: Placement
  // Hides the badge between 64rem and 75rem, where the headline reaches its position.
  wideOnly?: boolean
}[] = [
  {
    id: 'react',
    depth: 1,
    Icon: IconReact,
    sm: { x: 76.26, y: 6.78, size: 3.75, rotate: -6 },
    md: { x: 71.703, y: 5.688, size: 4.5, rotate: -6 },
    lg: { x: 70.139, y: -19.375, size: 5.7, rotate: -6 },
  },
  {
    id: 'typescript',
    depth: 0.5,
    Icon: IconTypeScript,
    sm: { x: 66.98, y: 12, size: 2.75, rotate: 5 },
    md: { x: 35.132, y: 11.813, size: 3.75, rotate: 5 },
    lg: { x: 41.944, y: 14.563, size: 4.5125, rotate: 5 },
  },
  {
    id: 'next',
    depth: 0.75,
    Icon: IconNextjs,
    sm: { x: 54.359, y: 16.75, size: 3.5, rotate: -4 },
    md: { x: 50.719, y: 7.25, size: 4.75, rotate: -4 },
    lg: { x: 53.681, y: 9.063, size: 5.225, rotate: -4 },
  },
  {
    id: 'astro',
    depth: 0.4,
    Icon: IconAstro,
    lg: { x: 84.861, y: -22, size: 4.275, rotate: 7 },
  },
  {
    id: 'tailwind',
    depth: 0.55,
    Icon: IconTailwind,
    lg: { x: 84.028, y: 1.875, size: 4.5125, rotate: -3 },
  },
  {
    id: 'claude',
    depth: 0.85,
    Icon: IconClaude,
    sm: { x: 80.769, y: 17.75, size: 3, rotate: 6 },
    md: { x: 67.026, y: 14.063, size: 4.5, rotate: 6 },
    lg: { x: 68.056, y: 6.875, size: 5.225, rotate: 6 },
  },
  {
    id: 'vscode',
    depth: 0.65,
    wideOnly: true,
    Icon: IconVscode,
    lg: { x: 73.056, y: -7.375, size: 5.225, rotate: -7 },
  },
  {
    id: 'ghostty',
    depth: 0.33,
    Icon: IconGhostty,
    lg: { x: 80.208, y: 13.063, size: 4.0375, rotate: 4 },
  },
  {
    id: 'figma',
    depth: 0.45,
    Icon: IconFigma,
    md: { x: 85.851, y: 11.813, size: 3.75, rotate: -5 },
    lg: { x: 87.569, y: -9.75, size: 4.5125, rotate: -5 },
  },
]

// Enter order runs from the badges nearest the hero's vertical middle to the ones nearest its edges.
// Each badge slides in from outside its position, away from the hero's center.
const ENTER_START_MS = 210
const ENTER_STEP_MS = 60
const ENTER_OFFSET_REM = 2.5

const enterOrder = [...badges]
  .sort((a, b) => Math.abs(a.lg?.y ?? 0) - Math.abs(b.lg?.y ?? 0))
  .map(({ id }) => id)

const enterStyle = (id: string, lg?: Placement) => {
  const dx = (lg?.x ?? 50) < 50 ? -1 : 1
  const dy = (lg?.y ?? 0) < 0 ? -1 : 1
  const delay = ENTER_START_MS + enterOrder.indexOf(id) * ENTER_STEP_MS
  return `--badge-x:${dx * ENTER_OFFSET_REM}rem;--badge-y:${dy * ENTER_OFFSET_REM}rem;animation-delay:${delay}ms;`
}

const placementStyle = (key: 'sm' | 'md' | 'lg', p?: Placement) =>
  p
    ? `--${key}-x:${p.x}%;--${key}-y:${p.y}rem;--${key}-s:${p.size}rem;--${key}-r:${p.rotate}deg;`
    : ''
---

<section
  id="hero"
  class="relative flex min-h-[calc(100dvh-16rem)] overflow-x-clip flex-col justify-center pt-8 [--scale-in:0.98] motion-reduce:[--scale-in:1]"
>
  <div class="wrapper relative flex flex-col items-start">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-y-0 right-[calc((100%-100vw)/2)] left-[calc((100%-100vw)/2)]"
    >
      {badges.map(({ id, depth, Icon, sm, md, lg, wideOnly }) => (
        <div
          data-badge={id}
          style={
            `--depth:${depth};` +
            placementStyle('sm', sm) +
            placementStyle('md', md) +
            placementStyle('lg', lg) +
            enterStyle(id, lg)
          }
          class={cn(
            'absolute animate-badge-in translate-x-[calc(var(--px,0)*var(--depth)*24px)] translate-y-[calc(var(--py,0)*var(--depth)*24px)] items-center justify-center rounded-2xl motion-reduce:[--badge-scale-in:1] motion-reduce:[--badge-x:0rem] motion-reduce:[--badge-y:0rem] border border-border bg-card text-foreground',
            sm
              ? 'hidden xxs:flex xxs:left-(--sm-x) xxs:top-[calc(50%+var(--sm-y))] xxs:size-(--sm-s) xxs:rotate-(--sm-r)'
              : 'hidden',
            md
              ? 'md:flex md:left-(--md-x) md:top-[calc(50%+var(--md-y))] md:size-(--md-s) md:rotate-(--md-r)'
              : 'md:hidden',
            lg
              ? wideOnly
                ? 'lg:hidden min-[75rem]:flex min-[75rem]:left-(--lg-x) min-[75rem]:top-[calc(50%+var(--lg-y))] min-[75rem]:size-(--lg-s) min-[75rem]:rotate-(--lg-r)'
                : 'lg:flex lg:left-(--lg-x) lg:top-[calc(50%+var(--lg-y))] lg:size-(--lg-s) lg:rotate-(--lg-r)'
              : 'lg:hidden',
          )}
        >
          <Icon className="size-[45%]" />
        </div>
      ))}
    </div>
    <p class="mb-6 inline-flex animate-enter items-center gap-2 rounded-full border-2 border-border px-3 py-1 text-xs font-semibold tracking-widest text-muted-foreground uppercase [--blur-in:0px] sm:mb-8">
      <span aria-hidden="true" class="size-2 rounded-full bg-success"></span>
      {availability.label}
    </p>
    <div class="relative">
      <h1 class="animate-enter text-6xl leading-[0.92] font-extrabold text-foreground [--blur-in:var(--blur-lg)] [--enter-opacity:1] sm:text-7xl md:text-8xl lg:text-9xl">
        {display}
      </h1>
    </div>
    <p class="mt-6 max-w-208 animate-enter text-2xl leading-snug text-pretty text-foreground [--blur-in:var(--blur-sm)] [animation-delay:70ms] sm:mt-8 sm:text-3xl lg:text-4xl">
      {tagline.map((segment) => (
        <>
          {segment.highlight ? (
            <span class="text-secondary">{segment.text}</span>
          ) : (
            segment.text
          )}
        </>
      ))}
    </p>
    <NarrationPlayer
      section="hero"
      class="mt-10 animate-enter [--blur-in:0px] [animation-delay:140ms] sm:mt-12"
    />
    <a
      href={actions.primary.href}
      class={cn(
        'mt-8 animate-enter [--blur-in:0px] [animation-delay:210ms] sm:mt-10',
        buttonVariants({ variant: 'default', size: 'default' }),
      )}
    >
      {actions.primary.label}
    </a>
  </div>
</section>
