---
import { getCollection } from 'astro:content'
import { getRelativeLocaleUrl } from 'astro:i18n'

import { buttonVariants } from '~/components/ui/button-variants'
import { cn } from '~/helpers/classnames'
import { parseLocale } from '~/helpers/content'
import {
  getLaunchYear,
  getProjectDestination,
  groupByYear,
  sortByLaunch,
} from '~/helpers/projects'
import { getLocalizedEntry } from '~/services/localized'
import IconArrowRight from '~icons/tabler/arrow-right'
import IconArrowUpRight from '~icons/tabler/arrow-up-right'

const locale = parseLocale(Astro.currentLocale)
const list = await getLocalizedEntry('projectsList', locale)

const { links, empty } = list.data

const entries = await getCollection('projectsContent', (entry) =>
  entry.id.startsWith(`${locale}/`),
)

const projects = sortByLaunch(entries).map((entry) => ({
  name: entry.data.name,
  category: entry.data.category,
  summary: entry.data.summary,
  year: getLaunchYear(entry.data.launch),
  destination: getProjectDestination(
    entry,
    getRelativeLocaleUrl(
      locale,
      `/projects/${entry.id.slice(locale.length + 1)}`,
    ),
  ),
}))

const groups = groupByYear(projects)

const tableGrid = 'md:grid md:grid-cols-[4.5rem_minmax(0,1fr)_auto] md:gap-x-8'
const groupGrid = 'md:col-span-3 md:grid md:grid-cols-subgrid'
const rowGrid =
  'relative flex flex-col gap-4 py-8 md:col-span-3 md:grid md:grid-cols-subgrid md:items-start md:gap-4 md:py-10'
const rowDivider =
  'before:absolute before:inset-x-0 before:top-0 before:h-px before:bg-border md:before:left-24'
---

<section
  class="flex-1 bg-linear-to-t from-popover to-transparent bg-size-[auto_24rem] bg-bottom bg-no-repeat pt-4 pb-24 md:pt-8 md:pb-28"
>
  <div class="wrapper">
    {
      projects.length > 0 ? (
        <div data-enter="block" class={cn('flex flex-col', tableGrid)}>
          {groups.map((group) => (
            <div class={cn('border-t border-border', groupGrid)}>
              {group.projects.map((project, index) => {
                const isFirst = index === 0

                return (
                  <article class={cn(rowGrid, !isFirst && rowDivider)}>
                    <span class="text-code text-secondary md:col-start-1 md:row-start-1 md:pt-2">
                      {isFirst ? group.year : ''}
                    </span>
                    <div class="flex flex-col gap-3 md:col-start-2 md:row-start-1">
                      <h2 class="flex flex-col gap-2 text-heading text-pretty text-foreground lg:flex-row lg:items-baseline lg:gap-8">
                        <span>{project.name}</span>
                        <span class="font-mono text-sm font-medium tracking-wider text-muted-foreground/50 uppercase">
                          {project.category}
                        </span>
                      </h2>

                      <p class="text-body leading-relaxed text-pretty text-muted-foreground/80">
                        {project.summary}
                      </p>
                    </div>
                    {project.destination.kind === 'internal' && (
                      <a
                        href={project.destination.href}
                        class={cn(
                          'group size-fit gap-2 self-end text-caption md:col-start-3 md:row-start-1 md:self-auto md:pt-2',
                          buttonVariants({ variant: 'link', size: 'inline' }),
                        )}
                      >
                        {links.more}
                        <IconArrowRight
                          className="size-4 shrink-0 transition-transform duration-200 motion-safe:group-hover:translate-x-1"
                          aria-hidden="true"
                        />
                      </a>
                    )}
                    {project.destination.kind === 'external' && (
                      <a
                        href={project.destination.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class={cn(
                          'group size-fit gap-2 self-end font-mono text-caption md:col-start-3 md:row-start-1 md:self-auto md:pt-2',
                          buttonVariants({ variant: 'link', size: 'inline' }),
                        )}
                      >
                        {project.destination.domain}
                        <IconArrowUpRight
                          className="size-4 shrink-0 transition-transform duration-200 motion-safe:group-hover:-translate-y-0.5"
                          aria-hidden="true"
                        />
                      </a>
                    )}
                    {project.destination.kind === 'offline' && (
                      <span class="self-end font-mono text-caption text-muted-foreground md:col-start-3 md:row-start-1 md:self-auto md:pt-2">
                        {links.offline}
                      </span>
                    )}
                  </article>
                )
              })}
            </div>
          ))}
        </div>
      ) : (
        <p
          data-enter="block"
          class="text-body leading-relaxed text-pretty text-muted-foreground"
        >
          {empty}
        </p>
      )
    }
  </div>
</section>
