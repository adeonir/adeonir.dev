---
import { getCollection } from 'astro:content'
import { getRelativeLocaleUrl } from 'astro:i18n'

import { parseLocale } from '~/helpers/content'
import {
  getLaunchYear,
  getProjectDestination,
  sortByLaunch,
} from '~/helpers/projects'
import { getLocalizedEntry } from '~/services/localized'
import IconArrowRight from '~icons/tabler/arrow-right'
import IconArrowUpRight from '~icons/tabler/arrow-up-right'

const locale = parseLocale(Astro.currentLocale)
const list = await getLocalizedEntry('projectsList', locale)

const { labels, links, empty } = list.data

const entries = await getCollection('projectsContent', (entry) =>
  entry.id.startsWith(`${locale}/`),
)

const projects = sortByLaunch(entries).map((entry) => ({
  name: entry.data.name,
  summary: entry.data.summary,
  stack: entry.data.stack,
  year: getLaunchYear(entry.data.launch),
  destination: getProjectDestination(
    entry,
    getRelativeLocaleUrl(
      locale,
      `/projects/${entry.id.slice(locale.length + 1)}`,
    ),
  ),
}))

const rowGrid =
  'md:grid md:grid-cols-[4rem_minmax(0,2fr)_minmax(0,1.5fr)_9rem] md:items-start md:gap-x-6'
---

<section class="pt-4 pb-16 md:pt-8 md:pb-20">
  <div class="wrapper">
    {
      projects.length > 0 ? (
        <div data-enter="block" class="flex flex-col">
          <div
            class={`hidden border-b border-border pb-3 text-label text-muted-foreground ${rowGrid}`}
          >
            <span>{labels.year}</span>
            <span>{labels.project}</span>
            <span>{labels.stack}</span>
            <span>{labels.link}</span>
          </div>
          {projects.map((project) => (
            <article
              class={`flex flex-col gap-3 border-b border-border py-6 ${rowGrid}`}
            >
              <div class="flex flex-row-reverse items-baseline justify-between gap-4 md:contents">
                <span class="shrink-0 text-label text-muted-foreground md:col-start-1 md:row-start-1">
                  {project.year}
                </span>
                <h2 class="text-title text-pretty text-foreground md:col-start-2 md:row-start-1">
                  {project.name}
                </h2>
              </div>
              <p class="text-caption leading-relaxed text-pretty text-muted-foreground md:col-start-2 md:row-start-2 md:mt-2">
                {project.summary}
              </p>
              <ul class="flex flex-wrap gap-2 md:col-start-3 md:row-start-1">
                {project.stack.map((item) => (
                  <li class="rounded-full bg-muted px-3 py-1 font-mono text-xs text-muted-foreground">
                    {item}
                  </li>
                ))}
              </ul>
              {project.destination.kind === 'case-study' && (
                <a
                  href={project.destination.href}
                  class="group inline-flex items-center gap-1.5 font-mono text-xs text-primary underline-offset-4 hover:underline focus-visible:rounded-xs focus-visible:ring-4 focus-visible:ring-ring/50 focus-visible:outline-none md:col-start-4 md:row-start-1"
                >
                  {links.more}
                  <IconArrowRight
                    className="size-4 shrink-0 transition-transform duration-200 motion-safe:group-hover:translate-x-1"
                    aria-hidden="true"
                  />
                </a>
              )}
              {project.destination.kind === 'external' && (
                <a
                  href={project.destination.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group inline-flex items-center gap-1.5 font-mono text-xs text-primary underline-offset-4 hover:underline focus-visible:rounded-xs focus-visible:ring-4 focus-visible:ring-ring/50 focus-visible:outline-none md:col-start-4 md:row-start-1"
                >
                  {project.destination.domain}
                  <IconArrowUpRight
                    className="size-4 shrink-0 transition-transform duration-200 motion-safe:group-hover:-translate-y-0.5"
                    aria-hidden="true"
                  />
                </a>
              )}
              {project.destination.kind === 'offline' && (
                <span class="font-mono text-xs text-muted-foreground md:col-start-4 md:row-start-1">
                  {links.offline}
                </span>
              )}
            </article>
          ))}
        </div>
      ) : (
        <p
          data-enter="block"
          class="max-w-[50ch] text-body leading-relaxed text-pretty text-muted-foreground"
        >
          {empty}
        </p>
      )
    }
  </div>
</section>
