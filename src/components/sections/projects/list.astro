---
import { getCollection } from 'astro:content'
import { getRelativeLocaleUrl } from 'astro:i18n'

import { buttonVariants } from '~/components/ui/button-variants'
import { cn } from '~/helpers/classnames'
import { parseLocale } from '~/helpers/content'
import {
  getLaunchYear,
  getProjectDestination,
  sortByLaunch,
} from '~/helpers/projects'
import { getLocalizedEntry } from '~/services/localized'
import IconArrowRight from '~icons/tabler/arrow-right'
import IconArrowUpRight from '~icons/tabler/arrow-up-right'

const locale = parseLocale(Astro.currentLocale)
const list = await getLocalizedEntry('projectsList', locale)

const { labels, links, empty } = list.data

const entries = await getCollection('projectsContent', (entry) =>
  entry.id.startsWith(`${locale}/`),
)

const projects = sortByLaunch(entries).map((entry) => ({
  name: entry.data.name,
  summary: entry.data.summary,
  stack: entry.data.stack,
  year: getLaunchYear(entry.data.launch),
  destination: getProjectDestination(
    entry,
    getRelativeLocaleUrl(
      locale,
      `/projects/${entry.id.slice(locale.length + 1)}`,
    ),
  ),
}))

const tableGrid =
  'md:grid md:grid-cols-[4rem_minmax(0,2fr)_minmax(0,1.5fr)_auto] md:gap-x-6'
const rowGrid = 'md:col-span-4 md:grid md:grid-cols-subgrid md:items-start'
---

<section
  class="flex-1 bg-linear-to-t from-popover to-transparent bg-size-[auto_24rem] bg-bottom bg-no-repeat pt-4 pb-24 md:pt-8 md:pb-28"
>
  <div class="wrapper">
    {
      projects.length > 0 ? (
        <div data-enter="block" class={`flex flex-col ${tableGrid}`}>
          <div
            class={`hidden border-b border-border pb-3 text-label text-muted-foreground ${rowGrid}`}
          >
            <span>{labels.year}</span>
            <span>{labels.project}</span>
            <span>{labels.stack}</span>
            <span>{labels.link}</span>
          </div>
          {projects.map((project) => (
            <article
              class={`flex flex-col border-b border-border py-6 last:border-b-0 ${rowGrid}`}
            >
              <div class="flex flex-row-reverse items-baseline justify-between gap-4 md:contents">
                <span class="shrink-0 text-sm text-muted-foreground md:col-start-1 md:row-start-1">
                  {project.year}
                </span>
                <div class="flex flex-col gap-1">
                  <h2 class="text-title text-pretty text-foreground md:col-start-2 md:row-start-1 md:-mt-1">
                    {project.name}
                  </h2>
                  <p class="text-caption leading-relaxed text-pretty text-muted-foreground md:col-start-2 md:row-start-2 md:mt-2">
                    {project.summary}
                  </p>
                </div>
              </div>
              <ul class="mt-6 flex flex-wrap gap-2 md:col-start-3 md:row-start-1 md:mt-0">
                {project.stack.map((item) => (
                  <li class="rounded-full bg-muted px-3 py-1 font-mono text-xs text-muted-foreground">
                    {item}
                  </li>
                ))}
              </ul>
              {project.destination.kind === 'internal' && (
                <a
                  href={project.destination.href}
                  class={cn(
                    'group mt-2 size-fit gap-2 self-end text-sm md:col-start-4 md:row-start-1 md:mt-0 md:self-auto',
                    buttonVariants({ variant: 'link', size: 'inline' }),
                  )}
                >
                  {links.more}
                  <IconArrowRight
                    className="size-4 shrink-0 transition-transform duration-200 motion-safe:group-hover:translate-x-1"
                    aria-hidden="true"
                  />
                </a>
              )}
              {project.destination.kind === 'external' && (
                <a
                  href={project.destination.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={cn(
                    'group mt-2 gap-2 self-end font-mono text-sm md:col-start-4 md:row-start-1 md:mt-0 md:self-auto',
                    buttonVariants({ variant: 'link', size: 'inline' }),
                  )}
                >
                  {project.destination.domain}
                  <IconArrowUpRight
                    className="size-4 shrink-0 transition-transform duration-200 motion-safe:group-hover:-translate-y-0.5"
                    aria-hidden="true"
                  />
                </a>
              )}
              {project.destination.kind === 'offline' && (
                <span class="mt-2 self-end font-mono text-xs text-muted-foreground md:col-start-4 md:row-start-1 md:mt-0 md:self-auto">
                  {links.offline}
                </span>
              )}
            </article>
          ))}
        </div>
      ) : (
        <p
          data-enter="block"
          class="max-w-[50ch] text-body leading-relaxed text-pretty text-muted-foreground"
        >
          {empty}
        </p>
      )
    }
  </div>
</section>
