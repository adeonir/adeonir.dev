---
import { getRelativeLocaleUrl } from 'astro:i18n'

import { FooterSignoff } from '~/components/islands/footer-signoff'
import Logo from '~/components/logo.astro'
import { parseLocale } from '~/helpers/content'
import { getLocalizedEntry } from '~/services/localized'

const locale = parseLocale(Astro.currentLocale)
const footer = await getLocalizedEntry('footer', 'footer', locale)
const homeURL = getRelativeLocaleUrl(locale)

const { brand, signoff } = footer.data
---

<footer class="bg-sunken">
  <div
    class="wrapper flex flex-col gap-6 py-12 md:flex-row md:items-center md:justify-between"
  >
    <div class="flex flex-col gap-2">
      <a
        href={homeURL}
        class="-mx-1.5 -my-0.5 shrink-0 self-start rounded-sm px-1.5 py-0.5 transition focus-visible:ring-4 focus-visible:ring-ring/50 focus-visible:ring-offset-2 focus-visible:ring-offset-background focus-visible:outline-none"
      >
        <Logo class="w-28" label={brand.text} />
      </a>
      <p class="font-mono text-xs text-muted-foreground">
        {brand.copyright}
      </p>
    </div>
    <FooterSignoff segments={signoff} client:visible />
  </div>
</footer>
