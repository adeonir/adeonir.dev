---
import { Image } from 'astro:assets'
import { getRelativeLocaleUrl } from 'astro:i18n'

import drinkingBeer from '~/assets/characters/drinking-beer.png'
import drinkingCoffee from '~/assets/characters/drinking-coffee.png'
import worried from '~/assets/characters/worried.png'
import { FooterSignoff } from '~/components/islands/footer-signoff'
import Logo from '~/components/logo.astro'
import { parseLocale } from '~/helpers/locale'
import { getLocalizedEntry } from '~/services/localized'

const locale = parseLocale(Astro.currentLocale)
const footer = await getLocalizedEntry('sharedFooter', locale)
const topURL = Astro.url.pathname
const colophonURL = getRelativeLocaleUrl(locale, '/colophon')

const { brand, signoff } = footer.data
const showCharacter = Astro.response.status !== 404
---

<footer class="relative bg-popover pt-8 before:pointer-events-none before:absolute before:inset-x-0 before:bottom-full before:-z-10 before:h-224 before:bg-linear-to-b before:from-transparent before:to-popover md:before:h-128">
  <div class="wrapper">
    <div class="flex flex-col-reverse gap-6 pb-12 md:flex-row md:items-end md:justify-between">
      <div class="flex flex-col gap-8 xs:mb-4 md:mb-8">
        <div class="flex flex-col gap-2">
          <a
            href={topURL}
            class="-mx-1.5 -my-0.5 shrink-0 self-start rounded-sm px-1.5 py-0.5 transition focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background focus-visible:outline-none"
          >
            <Logo class="w-28" label={brand.text} />
          </a>
          <p class="flex flex-wrap items-center gap-x-3 font-mono text-xs text-muted-foreground">
            {brand.copyright}
            <span aria-hidden="true">-</span>
            <a
              href={colophonURL}
              class="rounded-sm underline decoration-foreground/30 underline-offset-4 transition hover:decoration-foreground hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background focus-visible:outline-none"
            >
              {brand.colophon}
            </a>
          </p>
        </div>
        <FooterSignoff segments={signoff} client:visible />
      </div>
      {showCharacter ? (
        <>
          <Image
            src={drinkingCoffee}
            alt=""
            loading="lazy"
            decoding="async"
            widths={[224, 448]}
            sizes="(min-width: 768px) 224px, 112px"
            class="hidden w-auto self-end xxs:-mb-8 xxs:block xxs:h-44 xs:-mb-32 md:mb-0 md:h-56"
            data-character="coffee"
          />
          <Image
            src={drinkingBeer}
            alt=""
            loading="lazy"
            decoding="async"
            widths={[224, 448]}
            sizes="(min-width: 768px) 224px, 112px"
            class="hidden w-auto self-end xxs:-mb-8 xxs:block xxs:h-44 xs:-mb-32 md:mb-0 md:h-56"
            data-character="beer"
            hidden
          />
        </>
      ) : (
        <Image
          src={worried}
          alt=""
          loading="lazy"
          decoding="async"
          widths={[224, 448]}
          sizes="(min-width: 768px) 224px, 112px"
          class="h-44 w-auto self-end xxs:-mb-8 xs:-mb-32 md:mb-0 md:h-56"
        />
      )}
    </div>
  </div>
</footer>
