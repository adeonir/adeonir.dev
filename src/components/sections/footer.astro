---
import { getEntry } from 'astro:content'

const footer = await getEntry('footer', 'footer')

if (!footer) {
  throw new Error('Missing footer/footer entry')
}

const { brand, tagline } = footer.data
---

<footer class="border-t border-border bg-sunken">
  <div
    class="mx-auto flex max-w-5xl items-center justify-between gap-6 px-6 py-12"
  >
    <div class="flex flex-col gap-2">
      <a
        href="/"
        class="-mx-1.5 -my-0.5 shrink-0 self-start rounded-sm px-1.5 py-0.5 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background focus-visible:outline-none"
      >
        <img class="w-28" src="/logo.svg" alt={brand.text} />
      </a>
      <p class="font-mono text-caption text-muted-foreground">
        {brand.copyright}
      </p>
    </div>
    <p class="text-code text-muted-foreground">
      {
        tagline.map((segment) =>
          segment.emphasis ? (
            <span class="text-secondary">{segment.text}</span>
          ) : (
            segment.text
          ),
        )
      }
    </p>
  </div>
</footer>
