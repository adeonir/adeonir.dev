---
import { buttonVariants } from '~/components/ui/button-variants'
import { Eyebrow } from '~/components/ui/eyebrow'
import { parseLocale } from '~/helpers/content'
import { getLocalizedEntry } from '~/services/localized'
import IconFolder from '~icons/tabler/folder'

const locale = parseLocale(Astro.currentLocale)
const projects = await getLocalizedEntry('projects', 'projects', locale)

const { eyebrow, headline, body, holding } = projects.data
---

<section id="projects" class="py-16 md:py-24">
  <div class="wrapper">
    <div class="mt-6 grid grid-cols-1 gap-12 md:grid-cols-5">
      <div class="flex flex-col gap-6 md:col-span-2">
        <Eyebrow data-enter="block" variant="muted">{eyebrow}</Eyebrow>
        <h2 data-enter="block" class="text-display text-pretty text-foreground">
          {
            headline.map((segment) => (
              <>
                {segment.highlight ? (
                  <span class="text-secondary">{segment.text}</span>
                ) : (
                  segment.text
                )}
              </>
            ))
          }
        </h2>
        <p
          data-enter="block"
          class="text-body leading-relaxed text-pretty text-muted-foreground"
        >
          {body}
        </p>
      </div>
      <div class="md:col-span-3 md:pt-14">
        <div
          data-enter="block"
          class="flex flex-col gap-4 rounded-lg border border-border bg-sunken p-6 sm:p-8"
        >
          <IconFolder
            className="size-6 shrink-0 text-primary"
            aria-hidden="true"
          />
          <p
            class="text-body leading-relaxed text-pretty text-muted-foreground"
          >
            {
              holding.map((segment) =>
                segment.href ? (
                  <a
                    href={segment.href}
                    class={buttonVariants({ variant: 'link', size: 'inline' })}
                  >
                    {segment.text}
                  </a>
                ) : (
                  segment.text
                ),
              )
            }
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
