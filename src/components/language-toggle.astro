---
import { buttonVariants } from '~/components/ui/button-variants'
import { cn } from '~/helpers/classnames'
import type { Locale } from '~/helpers/content'
import { getLocalizedPath } from '~/helpers/locale-path'
import { getLocalizedEntry } from '~/services/localized'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const targetLocale: Locale = locale === 'pt' ? 'en' : 'pt'
const labels = await getLocalizedEntry('sharedLanguageToggle', locale)
const href = `${getLocalizedPath(Astro.url.pathname, targetLocale)}${Astro.url.search}`
---

<a
  href={href}
  data-language-link
  aria-label={labels.data.name}
  class={cn(buttonVariants({ variant: 'ghost', size: 'icon' }), 'font-mono')}
>
  {labels.data.code}
</a>
