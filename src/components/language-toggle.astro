---
import { LanguageToggle as LanguageToggleIsland } from '~/components/islands/language-toggle'
import type { Locale } from '~/helpers/locale'
import { getLocalizedPath } from '~/helpers/locale-path'
import { getLocalizedEntry } from '~/services/localized'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const targetLocale: Locale = locale === 'pt' ? 'en' : 'pt'
const labels = await getLocalizedEntry('sharedLanguageToggle', locale)
const href = `${getLocalizedPath(Astro.url.pathname, targetLocale)}${Astro.url.search}`
---

<LanguageToggleIsland
  client:load
  href={href}
  code={labels.data.code}
  name={labels.data.name}
/>
