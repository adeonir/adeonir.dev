---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

import { Tag } from '~/components/ui/tag'
import IconArrowRight from '~icons/tabler/arrow-right'

interface Props {
  name: string
  category: string
  stack: string[]
  cover: ImageMetadata
  coverAlt: string
  href: string
  sizes: string
}

const { name, category, stack, cover, coverAlt, href, sizes } = Astro.props
---

<a
  href={href}
  class="group @container block rounded-2xl focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background focus-visible:outline-none"
>
  <article class="relative isolate flex h-[calc(56.25cqw+140px)] flex-col justify-end overflow-hidden rounded-2xl border border-border/50 bg-card shadow-[0_-12px_32px_-8px_rgb(0_0_0/0.5)] light:shadow-[0_-12px_32px_-8px_rgb(0_0_0/0.25)] sm:h-[calc(56.25cqw+50px)]">
    <Image
      src={cover}
      alt={coverAlt}
      loading="lazy"
      decoding="async"
      widths={[480, 640, 960, 1280]}
      sizes={sizes}
      class="absolute inset-x-0 top-0 -z-10 h-auto w-full mask-[linear-gradient(to_bottom,rgb(0_0_0/1)_20%,rgb(0_0_0/0.95)_28%,rgb(0_0_0/0.82)_36%,rgb(0_0_0/0.62)_44%,rgb(0_0_0/0.4)_52%,rgb(0_0_0/0.2)_60%,rgb(0_0_0/0.07)_68%,rgb(0_0_0/0)_75%)] transition-transform duration-500 ease-out motion-safe:group-focus-within:scale-103 motion-safe:group-hover:scale-103"
    />
    <div class="flex items-end justify-between gap-6 p-6">
      <div class="flex flex-col gap-2">
        <p class="font-mono text-xs tracking-widest text-foreground uppercase">
          {category}
        </p>
        <h3 class="text-title font-bold text-pretty text-foreground">{name}</h3>
        <ul class="mt-2 flex h-7 flex-wrap gap-2 overflow-hidden">
          {stack.map((item) => (
            <li>
              <Tag className="border border-border bg-transparent py-0.75">
                {item}
              </Tag>
            </li>
          ))}
        </ul>
      </div>
      <IconArrowRight className="mb-1 size-5 shrink-0 text-foreground transition-[color,translate] duration-200 motion-safe:group-focus-within:translate-x-1 motion-safe:group-hover:translate-x-2" />
    </div>
  </article>
</a>
