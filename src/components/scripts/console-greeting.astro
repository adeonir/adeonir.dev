---
import { parseLocale } from '~/helpers/content'
import { getLocalizedEntry } from '~/services/localized'

const locale = parseLocale(Astro.currentLocale)
const entry = await getLocalizedEntry('sharedConsole', locale)

const { greeting } = entry.data
---

<script is:inline define:vars={{ greeting }}>
  console.log(greeting)
</script>
