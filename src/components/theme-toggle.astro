---
import { getEntry } from 'astro:content'

import { ThemeToggle as ThemeToggleIsland } from '~/components/islands/theme-toggle'

const labels = await getEntry('themeToggle', 'labels')

if (!labels) {
  throw new Error('Missing themeToggle/labels entry')
}
---

<ThemeToggleIsland client:load labels={labels.data} />
