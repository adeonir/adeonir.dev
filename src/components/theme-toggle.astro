---
import { ThemeToggle as ThemeToggleIsland } from '~/components/islands/theme-toggle'
import { parseLocale } from '~/helpers/locale'
import { getLocalizedEntry } from '~/services/localized'

const locale = parseLocale(Astro.currentLocale)
const labels = await getLocalizedEntry('sharedThemeToggle', locale)
---

<ThemeToggleIsland client:after-load labels={labels.data} />
