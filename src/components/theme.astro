<script is:inline>
  function applyTheme() {
    let stored = null
    try {
      stored = localStorage.getItem('theme')
    } catch {}
    document.documentElement.dataset.theme =
      stored === 'light' || stored === 'dark' ? stored : 'dark'
  }

  document.addEventListener('astro:after-swap', applyTheme)
  applyTheme()
</script>
