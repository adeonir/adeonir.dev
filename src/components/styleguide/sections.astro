---
import IconArrowRight from '~icons/tabler/arrow-right'

import Logo from '~/components/logo.astro'
import { ToastDemo } from '~/components/styleguide/toast'
import { Button } from '~/components/ui/button'
import { Eyebrow } from '~/components/ui/eyebrow'
import { Field } from '~/components/ui/field'
import { NavLink } from '~/components/ui/nav-link'

const surfaces = [
  {
    box: 'bg-sunken',
    text: 'text-sunken-foreground',
    label: 'sunken / sunken-foreground',
  },
  {
    box: 'bg-background',
    text: 'text-foreground',
    label: 'background / foreground',
  },
  {
    box: 'bg-card',
    text: 'text-card-foreground',
    label: 'card / card-foreground',
  },
  {
    box: 'bg-popover',
    text: 'text-popover-foreground',
    label: 'popover / popover-foreground',
  },
]

const accents = [
  {
    box: 'bg-primary',
    text: 'text-primary-foreground',
    label: 'primary / primary-foreground',
  },
  {
    box: 'bg-secondary',
    text: 'text-secondary-foreground',
    label: 'secondary / secondary-foreground',
  },
  {
    box: 'bg-muted',
    text: 'text-muted-foreground',
    label: 'muted / muted-foreground',
  },
  {
    box: 'bg-accent',
    text: 'text-accent-foreground',
    label: 'accent / accent-foreground',
  },
]

const status = [
  {
    box: 'bg-success',
    text: 'text-success-foreground',
    label: 'success / success-foreground',
  },
  {
    box: 'bg-error',
    text: 'text-error-foreground',
    label: 'error / error-foreground',
  },
  {
    box: 'bg-warning',
    text: 'text-warning-foreground',
    label: 'warning / warning-foreground',
  },
  {
    box: 'bg-info',
    text: 'text-info-foreground',
    label: 'info / info-foreground',
  },
]

const lines = [
  { cls: 'border-border', label: 'border' },
  { cls: 'border-input', label: 'input' },
  { cls: 'border-ring', label: 'ring' },
]

const inks = [
  { cls: 'text-foreground', label: 'foreground' },
  { cls: 'text-muted-foreground', label: 'muted-foreground' },
  { cls: 'text-primary', label: 'primary' },
  { cls: 'text-emphasis', label: 'emphasis' },
  { cls: 'text-destructive', label: 'destructive' },
]

const types = [
  { cls: 'text-display', label: 'text-display' },
  { cls: 'text-heading', label: 'text-heading' },
  { cls: 'text-title', label: 'text-title' },
  { cls: 'text-subtitle', label: 'text-subtitle' },
  { cls: 'text-body', label: 'text-body' },
  { cls: 'text-caption', label: 'text-caption' },
  { cls: 'text-label', label: 'text-label' },
  { cls: 'text-button', label: 'text-button' },
  { cls: 'text-code', label: 'text-code' },
]

const spacing = [
  { cls: 'w-1', label: '1 · 0.25rem' },
  { cls: 'w-2', label: '2 · 0.5rem' },
  { cls: 'w-3', label: '3 · 0.75rem' },
  { cls: 'w-4', label: '4 · 1rem' },
  { cls: 'w-5', label: '5 · 1.25rem' },
  { cls: 'w-6', label: '6 · 1.5rem' },
  { cls: 'w-8', label: '8 · 2rem' },
  { cls: 'w-11', label: '11 · 2.75rem' },
  { cls: 'w-12', label: '12 · 3rem' },
  { cls: 'w-16', label: '16 · 4rem' },
  { cls: 'w-24', label: '24 · 6rem' },
]

const radii = [
  { cls: 'rounded-xs', label: 'xs' },
  { cls: 'rounded-sm', label: 'sm' },
  { cls: 'rounded-md', label: 'md' },
  { cls: 'rounded-lg', label: 'lg' },
  { cls: 'rounded-xl', label: 'xl' },
  { cls: 'rounded-2xl', label: '2xl' },
  { cls: 'rounded-full', label: 'full' },
]

const widths = [
  { cls: 'border', label: 'border' },
  { cls: 'border-2', label: 'border-2' },
  { cls: 'border-4', label: 'border-4' },
]

const shadows = [
  { cls: 'shadow-2xs', label: '2xs' },
  { cls: 'shadow-xs', label: 'xs' },
  { cls: 'shadow-sm', label: 'sm' },
  { cls: 'shadow-md', label: 'md' },
  { cls: 'shadow-lg', label: 'lg' },
  { cls: 'shadow-xl', label: 'xl' },
  { cls: 'shadow-2xl', label: '2xl' },
]

const elevations = [
  { cls: '', label: 'none' },
  { cls: 'shadow-foreground/5 shadow-lg', label: 'floating' },
  { cls: 'shadow-primary/12 shadow-lg', label: 'tinted' },
]

const breakpoints = [
  { name: 'xxs', value: '24rem / 384px' },
  { name: 'xs', value: '32rem / 512px' },
  { name: 'sm', value: '40rem / 640px' },
  { name: 'md', value: '48rem / 768px' },
  { name: 'lg', value: '64rem / 1024px' },
  { name: 'xl', value: '80rem / 1280px' },
  { name: '2xl', value: '96rem / 1536px' },
]
---

<div class="flex flex-col gap-12">
  <header>
    <h1 class="text-display">Styleguide</h1>
    <hr class="mt-6 border-t border-border" />
  </header>

  <section class="flex flex-col gap-4">
    <h2 class="text-title">Colors</h2>
    <div class="flex gap-3">
      {
        [surfaces, accents, status].map((group) => (
          <div class="flex flex-1 flex-col gap-3">
            {group.map((c) => (
              <div
                class:list={[
                  'flex h-20 flex-col justify-end rounded-md border border-border p-3',
                  c.box,
                  c.text,
                ]}
              >
                <span class="text-caption">{c.label}</span>
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </section>

  <section class="flex flex-col gap-4">
    <h2 class="text-title">Border colors</h2>
    <div class="flex gap-3">
      {
        lines.map((l) => (
          <div class="flex flex-col items-center gap-1">
            <div class:list={['size-12 rounded-md border-2', l.cls]} />
            <span class="text-caption text-muted-foreground">{l.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="flex flex-col gap-4">
    <h2 class="text-title">Text colors</h2>
    <div class="flex flex-wrap gap-6">
      {
        inks.map((i) => (
          <div class="flex flex-col gap-1">
            <span class:list={['text-body', i.cls]}>The quick brown fox</span>
            <span class="text-caption text-muted-foreground">{i.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="flex flex-col gap-4">
    <h2 class="text-title">Type</h2>
    <div class="flex flex-col gap-3">
      {
        types.map((t) => (
          <div class="flex flex-col gap-1 border-b border-border pb-3">
            <span class="text-caption text-muted-foreground">{t.label}</span>
            <span class={t.cls}>The quick brown fox jumps</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="flex flex-col gap-4">
    <h2 class="text-title">Spacing</h2>
    <div class="flex flex-col gap-2">
      {
        spacing.map((s) => (
          <div class="flex items-center gap-3">
            <div class:list={['h-3 rounded-xs bg-primary', s.cls]} />
            <span class="text-caption text-muted-foreground">{s.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="flex flex-col gap-4">
    <h2 class="text-title">Radius</h2>
    <div class="flex flex-wrap gap-3">
      {
        radii.map((r) => (
          <div class="flex flex-col items-center gap-1">
            <div class:list={['size-14 border border-border bg-card', r.cls]} />
            <span class="text-caption text-muted-foreground">{r.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="flex flex-col gap-4">
    <h2 class="text-title">Border width</h2>
    <div class="flex gap-3">
      {
        widths.map((w) => (
          <div class="flex flex-col items-center gap-1">
            <div
              class:list={['size-14 rounded-md border-border bg-card', w.cls]}
            />
            <span class="text-caption text-muted-foreground">{w.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="flex flex-col gap-4">
    <h2 class="text-title">Elevation</h2>
    <div class="flex flex-wrap gap-4">
      {
        shadows.map((s) => (
          <div class="flex flex-col items-center gap-1">
            <div
              class:list={[
                'size-14 rounded-lg border border-border bg-card',
                s.cls,
              ]}
            />
            <span class="text-caption text-muted-foreground">{s.label}</span>
          </div>
        ))
      }
    </div>
    <div class="flex flex-wrap gap-4">
      {
        elevations.map((e) => (
          <div class="flex flex-col items-center gap-1">
            <div
              class:list={[
                'size-14 rounded-lg border border-border bg-card',
                e.cls,
              ]}
            />
            <span class="text-caption text-muted-foreground">{e.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="flex flex-col gap-4">
    <h2 class="text-title">Breakpoints</h2>
    <div class="flex flex-col gap-2">
      {
        breakpoints.map((b) => (
          <div class="flex items-center justify-between border-b border-border pb-2">
            <span class="text-code">{b.name}</span>
            <span class="text-caption text-muted-foreground">{b.value}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="flex flex-col gap-4">
    <h2 class="text-title">Components</h2>
    <div class="flex flex-col gap-6">
      <div class="flex flex-col gap-2">
        <span class="text-caption text-muted-foreground">Logo</span>
        <Logo class="w-40" />
      </div>
      <div class="flex flex-col gap-2">
        <span class="text-caption text-muted-foreground">Eyebrow</span>
        <Eyebrow>Label</Eyebrow>
      </div>
      <div class="flex flex-col gap-2">
        <span class="text-caption text-muted-foreground">Button</span>
        <div class="flex flex-wrap items-center gap-3">
          <Button>Primary</Button>
          <Button variant="outline">Outline</Button>
          <Button size="icon" aria-label="Example icon button">
            <IconArrowRight className="size-4" />
          </Button>
        </div>
      </div>
      <div class="flex flex-col gap-2">
        <span class="text-caption text-muted-foreground">NavLink</span>
        <NavLink href="#">nav link</NavLink>
      </div>
      <div class="flex flex-col gap-2">
        <span class="text-caption text-muted-foreground">Field</span>
        <div class="flex flex-col gap-4">
          <Field label="Label" name="sg-field" placeholder="Placeholder" />
          <Field
            label="Message"
            name="sg-field-message"
            placeholder="Placeholder"
            multiline
          />
          <Field
            label="Invalid"
            name="sg-field-invalid"
            placeholder="Placeholder"
            invalid
            error="This field is required."
          />
          <Field
            label="Disabled"
            name="sg-field-disabled"
            placeholder="Placeholder"
            disabled
          />
        </div>
      </div>
      <ToastDemo client:load />
    </div>
  </section>
</div>
