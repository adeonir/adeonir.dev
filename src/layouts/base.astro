---
import { getEntry } from 'astro:content'
import { SEO } from 'astro-seo'
import '~/styles/global.css'

interface Props {
  title: string
  description?: string
  image?: string
  noindex?: boolean
}

const settings = await getEntry('settings', 'metadata')

if (!settings) {
  throw new Error('Missing settings/metadata entry')
}

const { title, description, image, noindex = false } = Astro.props

const fullTitle = `${title} | ${settings.data.siteName}`
const resolvedDescription = description?.trim()
  ? description
  : settings.data.description
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const ogImageURL = new URL(
  image?.trim() ? image : settings.data.ogImage,
  Astro.site,
).href
---

<!doctype html>
<html lang={settings.data.locale} class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title={title}
      titleTemplate={`%s | ${settings.data.siteName}`}
      description={resolvedDescription}
      canonical={canonicalURL}
      noindex={noindex}
      openGraph={{
        basic: {
          title: fullTitle,
          type: 'website',
          image: ogImageURL,
          url: canonicalURL,
        },
        optional: { description: resolvedDescription },
        image: { alt: fullTitle, width: 1200, height: 630 },
      }}
      twitter={{ card: 'summary_large_image' }}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="h-full bg-background text-foreground antialiased">
    <slot />
  </body>
</html>
