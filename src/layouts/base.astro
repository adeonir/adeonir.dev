---
import { Font } from 'astro:assets'
import { ClientRouter } from 'astro:transitions'
import { SEO } from 'astro-seo'

import Analytics from '~/components/scripts/analytics.astro'
import ConsoleGreeting from '~/components/scripts/console-greeting.astro'
import Footer from '~/components/sections/footer.astro'
import Header from '~/components/sections/header.astro'
import Theme from '~/components/scripts/theme.astro'
import { getAgentDocumentPath } from '~/helpers/agent-documents'
import { parseLocale } from '~/helpers/content'
import { getLocalizedPath } from '~/helpers/locale-path'
import { getLocalizedEntry } from '~/services/localized'
import '~/styles/global.css'

interface Props {
  title?: string
  titleKey?: 'home' | 'notFound' | 'maintenance'
  description?: string
  image?: string
  noindex?: boolean
  shell?: boolean
}

const locale = parseLocale(Astro.currentLocale)
const settings = await getLocalizedEntry('sharedSettings', locale)
const openGraphLocale = locale === 'pt' ? 'pt_BR' : 'en_US'
const alternateOpenGraphLocale = locale === 'pt' ? 'en_US' : 'pt_BR'

const {
  title,
  titleKey,
  description,
  image,
  noindex = false,
  shell = false,
} = Astro.props

const resolvedTitle = titleKey ? settings.data.pageTitles[titleKey] : title

if (!resolvedTitle) {
  throw new Error('A page title or title key is required')
}

const fullTitle = `${resolvedTitle} | ${settings.data.siteName}`
const resolvedDescription = description?.trim()
  ? description
  : settings.data.description
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const portuguesePath = getLocalizedPath(Astro.url.pathname, 'pt')
const englishPath = getLocalizedPath(portuguesePath, 'en')
const portugueseURL = new URL(portuguesePath, Astro.site)
const englishURL = new URL(englishPath, Astro.site)
const agentMarkdownURL = new URL(
  getAgentDocumentPath(locale, 'markdown'),
  Astro.site,
)
const agentLlmsURL = new URL(getAgentDocumentPath(locale, 'llms'), Astro.site)
const ogImageURL = new URL(
  image?.trim() ? image : settings.data.ogImage,
  Astro.site,
).href
---

<!doctype html>
<html
  lang={settings.data.locale}
  data-theme="dark"
  class="h-full scroll-smooth font-sans"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1e1e2e" />

    <Theme />

    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-fira-code" />

    <SEO
      title={resolvedTitle}
      titleTemplate={`%s | ${settings.data.siteName}`}
      description={resolvedDescription}
      canonical={canonicalURL}
      noindex={noindex}
      languageAlternates={[
        { href: portugueseURL, hrefLang: 'pt-BR' },
        { href: englishURL, hrefLang: 'en' },
        { href: portugueseURL, hrefLang: 'x-default' },
      ]}
      openGraph={{
        basic: {
          title: fullTitle,
          type: 'website',
          image: ogImageURL,
          url: canonicalURL,
        },
        optional: {
          description: resolvedDescription,
          locale: openGraphLocale,
          localeAlternate: [alternateOpenGraphLocale],
        },
        image: { alt: fullTitle, width: 1200, height: 630 },
      }}
      twitter={{ card: 'summary_large_image' }}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {
      titleKey === 'home' && (
        <>
          <link rel="alternate" type="text/markdown" href={agentMarkdownURL} />
          <link rel="describedby" href={agentLlmsURL} />
        </>
      )
    }

    <ClientRouter />
    <Analytics />
    <ConsoleGreeting />
  </head>
  <body
    class="flex min-h-dvh flex-col overflow-x-clip bg-background bg-linear-to-b from-sunken/50 to-transparent bg-size-[auto_400px] bg-no-repeat text-foreground antialiased"
  >
    {
      shell ? (
        <>
          <Header />
          <main class="flex flex-1 flex-col">
            <slot />
          </main>
          <Footer />
        </>
      ) : (
        <slot />
      )
    }
    <script>
      import '~/scripts/anchor-nav'
      import '~/scripts/header-scroll'
      import '~/scripts/language-nav'
      import '~/scripts/motion'
    </script>
  </body>
</html>
