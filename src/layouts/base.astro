---
import { Font } from 'astro:assets'
import { getEntry } from 'astro:content'
import { ClientRouter } from 'astro:transitions'
import { SEO } from 'astro-seo'
import Analytics from '~/components/analytics.astro'
import Footer from '~/components/sections/footer.astro'
import Header from '~/components/sections/header.astro'
import { Toaster } from '~/components/islands/toaster'
import '~/styles/global.css'

interface Props {
  title: string
  description?: string
  image?: string
  noindex?: boolean
  shell?: boolean
}

const settings = await getEntry('settings', 'metadata')

if (!settings) {
  throw new Error('Missing settings/metadata entry')
}

const {
  title,
  description,
  image,
  noindex = false,
  shell = false,
} = Astro.props

const fullTitle = `${title} | ${settings.data.siteName}`
const resolvedDescription = description?.trim()
  ? description
  : settings.data.description
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const ogImageURL = new URL(
  image?.trim() ? image : settings.data.ogImage,
  Astro.site,
).href
---

<!doctype html>
<html
  lang={settings.data.locale}
  data-theme="dark"
  class="h-full scroll-pt-32 scroll-smooth font-sans motion-reduce:scroll-auto md:scroll-pt-40"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-fira-code" />

    <SEO
      title={title}
      titleTemplate={`%s | ${settings.data.siteName}`}
      description={resolvedDescription}
      canonical={canonicalURL}
      noindex={noindex}
      openGraph={{
        basic: {
          title: fullTitle,
          type: 'website',
          image: ogImageURL,
          url: canonicalURL,
        },
        optional: { description: resolvedDescription },
        image: { alt: fullTitle, width: 1200, height: 630 },
      }}
      twitter={{ card: 'summary_large_image' }}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <ClientRouter />
    <Analytics />
  </head>
  <body
    class="flex min-h-dvh flex-col bg-background text-foreground antialiased"
  >
    {
      shell ? (
        <>
          <Header />
          <main class="wrapper flex flex-1 flex-col gap-16 py-16 md:gap-24 md:py-24">
            <slot />
          </main>
          <Footer />
        </>
      ) : (
        <slot />
      )
    }
    <Toaster client:load transition:persist />
    <script>
      import '~/scripts/anchor-nav'
    </script>
  </body>
</html>
