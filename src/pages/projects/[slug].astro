---
import { type CollectionEntry, getCollection } from 'astro:content'

import Body from '~/components/sections/project/body.astro'
import Header from '~/components/sections/project/header.astro'
import Meta from '~/components/sections/project/meta.astro'
import Layout from '~/layouts/base.astro'

interface Props {
  entry: CollectionEntry<'projectsContent'>
}

export async function getStaticPaths() {
  const entries = await getCollection('projectsContent', (entry) =>
    entry.id.startsWith('pt/'),
  )

  return entries.map((entry) => ({
    params: { slug: entry.id.slice('pt/'.length) },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { name, kind, category, summary, launch, role, stack, url } = entry.data
---

<Layout title={name} description={summary} shell>
  <article>
    <Header kind={kind} category={category} name={name} summary={summary} />
    <Meta launch={launch} role={role} stack={stack} url={url} />
    <Body entry={entry} />
  </article>
</Layout>
