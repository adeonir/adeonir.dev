---
import { type CollectionEntry, getCollection } from 'astro:content'

import Body from '~/components/sections/project/body.astro'
import Header from '~/components/sections/project/header.astro'
import Meta from '~/components/sections/project/meta.astro'
import Nav from '~/components/sections/project/nav.astro'
import { Divider } from '~/components/ui/divider'
import Layout from '~/layouts/base.astro'

interface Props {
  entry: CollectionEntry<'projectContent'>
}

export async function getStaticPaths() {
  const entries = await getCollection('projectContent', (entry) =>
    entry.id.startsWith('en/'),
  )

  return entries.map((entry) => ({
    params: { slug: entry.id.slice('en/'.length) },
    props: { entry },
  }))
}

const { entry } = Astro.props
const {
  name,
  kind,
  category,
  type,
  summary,
  launch,
  role,
  stack,
  url,
  repository,
} = entry.data
---

<Layout title={name} description={summary} shell>
  <article>
    <Header
      kind={kind}
      category={category}
      name={name}
      summary={summary}
      url={url}
      repository={repository}
    />
    <Divider className="mx-auto my-8 flex w-full max-w-2xl md:my-16" />
    <Meta launch={launch} role={role} type={type} stack={stack} />
    <Body entry={entry} />
    <Divider className="mx-auto my-8 flex w-full max-w-2xl md:my-16" />
    <Nav slug={entry.id.slice('en/'.length)} />
  </article>
</Layout>
